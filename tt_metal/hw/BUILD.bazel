load("@rules_cc//cc:cc_library.bzl", "cc_library")

"""JIT build input filegroups for TT-Metalium kernel compilation.

Packages all runtime inputs needed by the JIT kernel compilation system
(tt_metal/jit_build/build.cpp) into Bazel filegroup targets.  These
correspond to the CMake FILE_SET jit_api and FILE_SET toolchain install
rules in tt_metal/hw/CMakeLists.txt (lines 508-762).

The JIT system compiles firmware and user kernels at runtime using:
  1. Preprocessed linker scripts (from //tt_metal/hw/toolchain)
  2. Device headers (inc/api, inc/internal, ckernels)
  3. Firmware source files (firmware/src/)
  4. Support object libraries (built from //tt_metal/hw/toolchain
     and //tt_metal/hw/firmware/src/tt-1xx cc_library targets)

Usage:
    bazel build //tt_metal/hw:jit_build_inputs
"""

package(default_visibility = ["//visibility:public"])

# ===================================================================
# JIT headers — API, internal, and experimental
#
# These are the headers accessible via -I flags set up by
# JitBuildEnv::init() in build.cpp (lines 281-296) and
# HalJitBuildQueryInterface::includes() in the HAL implementations.
#
# Note: glob() cannot cross Bazel package boundaries, so
# architecture-specific headers under inc/internal/{arch}/ that have
# their own BUILD files are referenced via label.
# ===================================================================

filegroup(
    name = "jit_api_headers",
    srcs = glob(
        [
            "inc/api/**/*.h",
            "inc/api/**/*.hpp",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "jit_hostdev_headers",
    srcs = glob(
        [
            "inc/hostdev/**/*.h",
            "inc/hostdev/**/*.hpp",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "jit_internal_common_headers",
    srcs = glob(
        [
            "inc/internal/**/*.h",
            "inc/internal/**/*.hpp",
        ],
        # Exclude directories that are separate Bazel packages
        exclude = [
            "inc/internal/tt-1xx/wormhole/**",
            "inc/internal/tt-1xx/blackhole/**",
            "inc/internal/tt-2xx/quasar/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "jit_experimental_headers",
    srcs = glob(
        [
            "inc/experimental/**/*.h",
            "inc/experimental/**/*.hpp",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "jit_headers",
    srcs = [
        ":jit_api_headers",
        ":jit_experimental_headers",
        ":jit_hostdev_headers",
        ":jit_internal_common_headers",
        "//tt_metal/hw/inc/internal/tt-1xx/blackhole:all_headers",
        "//tt_metal/hw/inc/internal/tt-1xx/wormhole:all_headers",
        "//tt_metal/hw/inc/internal/tt-2xx/quasar:all_headers",
    ],
)

# ===================================================================
# CKernel headers — architecture-specific compute kernel headers
#
# Referenced via HalJitBuildQueryInterface::includes() in each
# architecture's HAL implementation (e.g., wh_hal.cpp, bh_hal.cpp).
# ===================================================================

filegroup(
    name = "wormhole_ckernel_headers",
    srcs = glob(["ckernels/wormhole_b0/**/*.h"]),
)

filegroup(
    name = "blackhole_ckernel_headers",
    srcs = glob(["ckernels/blackhole/**/*.h"]),
)

filegroup(
    name = "quasar_ckernel_headers",
    srcs = glob(["ckernels/quasar/**/*.h"]),
)

filegroup(
    name = "jit_ckernel_headers",
    srcs = [
        ":blackhole_ckernel_headers",
        ":quasar_ckernel_headers",
        ":wormhole_ckernel_headers",
    ],
)

# ===================================================================
# Firmware source files
#
# The JIT system compiles firmware from source at runtime.
# tt-2xx sources can be globbed directly; tt-1xx sources are in a
# separate Bazel package and referenced via label.
# ===================================================================

filegroup(
    name = "tt2xx_firmware_sources",
    srcs = glob(["firmware/src/tt-2xx/**/*.cc", "firmware/src/tt-2xx/**/*.c"]),
)

filegroup(
    name = "jit_firmware_sources",
    srcs = [
        ":tt2xx_firmware_sources",
        "//tt_metal/hw/firmware/src/tt-1xx:firmware_sources",
    ],
)

# ===================================================================
# Aggregate: all JIT build inputs
#
# Collects source/data inputs the JIT compiler needs at runtime:
#   - Preprocessed linker scripts (generated by Bazel rules)
#   - Linker script templates (unpreprocessed .ld sources)
#   - Device and compute kernel headers
#   - Firmware source files
#
# Support object libraries (tmu_crt0, substitutes, noc, tdma_xmov,
# wh_iram_*) are cc_library targets in //tt_metal/hw/toolchain and
# //tt_metal/hw/firmware/src/tt-1xx — they are built separately and
# should be declared as deps, not included in this filegroup.
# ===================================================================

# ===================================================================
# Host-device shared headers as a cc_library.
#
# Mirrors the CMake INTERFACE library target `hw` (Metalium::Metal::Hardware)
# for the subset of headers needed by host-side compilation.
# The include path is set so consumers can use workspace-root-relative
# includes like: #include "tt_metal/hw/inc/hostdev/fabric_telemetry_msgs.h"
# ===================================================================

cc_library(
    name = "hw",
    hdrs = glob(
        [
            "inc/api/**/*.h",
            "inc/api/**/*.hpp",
            "inc/hostdev/**/*.h",
            "inc/hostdev/**/*.hpp",
            # Common internal headers shared across architectures (e.g., risc_attribs.h,
            # internal/tensor/const.h). Recursive glob stops at subpackage boundaries
            # (tt-1xx/wormhole, tt-1xx/blackhole, tt-2xx/quasar have their own BUILD).
            "inc/internal/**/*.h",
            "inc/internal/**/*.hpp",
        ],
        allow_empty = True,
    ),
    # Matches CMake: target_include_directories(hw INTERFACE ${PROJECT_SOURCE_DIR}/tt_metal/hw/inc)
    # Allows consumers to #include "hostdev/dev_msgs.h", "internal/risc_attribs.h",
    # and "api/debug/ring_buffer.h".
    includes = ["inc"],
)

filegroup(
    name = "jit_build_inputs",
    srcs = [
        ":jit_ckernel_headers",
        ":jit_firmware_sources",
        ":jit_headers",
        "//tt_metal/hw/toolchain:all_linker_scripts",
        "//tt_metal/hw/toolchain:linker_script_sources",
    ],
)

# Source-only files for wheel packaging. Excludes generated linker scripts
# (preprocessed .ld files) to avoid conflicts with source .ld files that
# share the same basename.
filegroup(
    name = "wheel_data",
    srcs = [
        ":jit_ckernel_headers",
        ":jit_firmware_sources",
        ":jit_headers",
        "//tt_metal/hw/toolchain:linker_script_sources",
    ],
)
