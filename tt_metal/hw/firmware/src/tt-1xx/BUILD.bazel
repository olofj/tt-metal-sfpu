"""Firmware cross-compilation targets for TT RISC-V processors.

Produces bare-metal ELF binaries for each (processor, architecture) combination
by cross-compiling firmware source files with the SFPI RISC-V toolchain and
linking against pre-compiled support objects and preprocessed linker scripts.

Mirrors the JIT firmware build in tt_metal/jit_build/build.cpp and the
pre-compiled object build in tt_metal/hw/CMakeLists.txt (lines 322-404).

Usage:
    bazel build --config=sfpi-wormhole //tt_metal/hw/firmware/src/tt-1xx:all
    bazel build --config=sfpi-blackhole //tt_metal/hw/firmware/src/tt-1xx:all

    # Single target:
    bazel build --config=sfpi-wormhole //tt_metal/hw/firmware/src/tt-1xx:brisc_wormhole
"""

load(":firmware_defs.bzl", "all_firmware")

package(default_visibility = ["//visibility:public"])

# ===================================================================
# Per-architecture support libraries (compiled with SFPI cross-compiler)
# ===================================================================

_COMMON_FW_COPTS = [
    "-DTENSIX_FIRMWARE",
    "-DLOCAL_MEM_EN=0",
]

# Firmware targets require the SFPI RISC-V cross-compiler.
# `bazel build ...` (host platform) skips them automatically.
_RISCV_COMPAT = ["@platforms//cpu:riscv32"]

# NOC initialization — C code, architecture-specific
# Mirrors: "noc.o:tt_metal/hw/firmware/src/tt-1xx/${ARCH}/noc.c"
cc_library(
    name = "noc_wormhole",
    srcs = ["wormhole/noc.c"],
    copts = _COMMON_FW_COPTS + [
        "-DARCH_WORMHOLE",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/wormhole_b0_defines",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/noc",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
    target_compatible_with = _RISCV_COMPAT,
)

cc_library(
    name = "noc_blackhole",
    srcs = ["blackhole/noc.c"],
    copts = _COMMON_FW_COPTS + [
        "-DARCH_BLACKHOLE",
        "-Itt_metal/hw/inc/internal/tt-1xx/blackhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/blackhole/noc",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
    target_compatible_with = _RISCV_COMPAT,
)

# TDMA transfer functions — C code, needs architecture-specific tensix headers
# Mirrors: "tdma_xmov.o:tt_metal/hw/firmware/src/tt-1xx/tdma_xmov.c"
cc_library(
    name = "tdma_xmov_wormhole",
    srcs = ["tdma_xmov.c"],
    copts = _COMMON_FW_COPTS + [
        "-DARCH_WORMHOLE",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/wormhole_b0_defines",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/noc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
    target_compatible_with = _RISCV_COMPAT,
)

cc_library(
    name = "tdma_xmov_blackhole",
    srcs = ["tdma_xmov.c"],
    copts = _COMMON_FW_COPTS + [
        "-DARCH_BLACKHOLE",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/inc/internal/tt-1xx/blackhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/blackhole/noc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
    target_compatible_with = _RISCV_COMPAT,
)

# ===================================================================
# Firmware source files for JIT compilation
#
# The JIT system compiles these at runtime via HalJitBuildQueryInterface::srcs().
# Packaged as a filegroup so downstream targets can declare data dependencies.
# ===================================================================

filegroup(
    name = "firmware_sources",
    srcs = glob(["**/*.cc", "**/*.c", "**/*.cpp"]),
)

# ===================================================================
# Firmware binary targets — generated by macro
# ===================================================================

all_firmware("wormhole")
all_firmware("blackhole")
