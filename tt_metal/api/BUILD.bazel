# tt-metalium public API headers.
#
# The full set of headers will be assembled as part of Phase 4 (core
# tt_metal library). For now, subsets are exported as separate targets
# so that individual module BUILD files (common, impl, etc.) can
# depend on the API headers they define.

load("//bazel:cc_fbs.bzl", "cc_fbs_library", "fbs_library")

package(default_visibility = ["//tt_metal:__subpackages__"])

# API headers for types defined in tt_metal/common.
# Includes: CoreCoord, Shape, MeshCoord, HostBuffer, bfloat types, etc.
cc_library(
    name = "common_api_hdrs",
    hdrs = [
        "tt-metalium/bfloat16.hpp",
        "tt-metalium/bfloat4.hpp",
        "tt-metalium/bfloat8.hpp",
        "tt-metalium/core_coord.hpp",
        "tt-metalium/host_buffer.hpp",
        "tt-metalium/maybe_remote.hpp",
        "tt-metalium/memory_pin.hpp",
        "tt-metalium/mesh_coord.hpp",
        "tt-metalium/shape.hpp",
        "tt-metalium/shape2d.hpp",
        "tt-metalium/shape_base.hpp",
        "tt-metalium/tt_backend_api_types.hpp",
        "tt-metalium/work_split.hpp",
    ],
    # Two include roots:
    # 1. "." makes <tt-metalium/core_coord.hpp> work
    # 2. "tt-metalium" makes bare <core_coord.hpp> work (legacy includes)
    includes = [
        ".",
        "tt-metalium",
    ],
    deps = [
        "//tt_stl",
        "//tt_metal/third_party/umd/device",
        "@enchantum//:enchantum",
        "@fmt",
        "@nlohmann_json//:json",
    ],
)

# FlatBuffer schema for MeshCoordinate — used by distributed and ttnn schemas.
# The fbs_library provides the include root (tt_metal/api) so that downstream
# schemas can write: include "tt-metalium/serialized_descriptors/mesh_coordinate.fbs"
fbs_library(
    name = "mesh_coordinate_fbs",
    srcs = ["tt-metalium/serialized_descriptors/mesh_coordinate.fbs"],
    include_root = "tt_metal/api",
    visibility = [
        "//tt_metal:__subpackages__",
        "//ttnn:__subpackages__",
    ],
)

cc_fbs_library(
    name = "mesh_coordinate_cc_fbs",
    srcs = ["tt-metalium/serialized_descriptors/mesh_coordinate.fbs"],
    visibility = [
        "//tt_metal:__subpackages__",
        "//ttnn:__subpackages__",
    ],
)
