# impl — core TT-Metalium implementation library.
#
# Mirrors the CMake OBJECT library: Metalium::Metal::Impl
# Contains ~102 .cpp files covering device management, dispatch, buffers,
# profiling, debug tools, flatbuffer serialization, and more.
#
# Code generation:
#   - FlatBuffers: 5 .fbs schemas (in flatbuffer/ sub-package)
#   - Cap'n Proto: rpc.capnp for inspector RPC interface
#   - Python codegen: generate_rpc_server.py for callback-based RPC server

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:cc_capnp.bzl", "cc_capnp_library")

package(default_visibility = [
    "//tt_metal:__subpackages__",
    "//tests:__subpackages__",
])

# ---------------------------------------------------------------------------
# Header-only subset — breaks the llrt <-> impl circular dependency.
#
# In CMake, llrt and impl are both OBJECT libraries merged into a single
# monolithic tt_metal.so. Source files in llrt/ #include headers from impl/
# but do not link against impl's .cpp files at that stage.
#
# This target exports ALL impl/ headers so that llrt, distributed, and
# other internal libraries can compile against them.
# ---------------------------------------------------------------------------

cc_library(
    name = "impl_hdrs",
    hdrs = glob(
        [
            "**/*.hpp",
            "**/*.h",
        ],
        allow_empty = True,
    ),
    includes = [
        "..",
        ".",
        "debug",
        "profiler",
    ],
    deps = [
        "//tt_metal/api:impl_api_hdrs",
        "//tt_metal/distributed:distributed_hdrs",
        "//tt_metal/fabric:fabric_hdrs",
        "//tt_metal/hostdevcommon",
        "//tt_metal/hw",
        "//tt_metal/impl/flatbuffer:flatbuffer_hdrs",
        "//tt_metal/jit_build:jit_build_hdrs",
        "//tt_metal/llrt:llrt_hdrs",
        "@umd//device",
        "//tt_metal/tools:profiler_hdrs",
        "//tt_stl",
        "@enchantum//:enchantum",
        "@fmt",
        "@nlohmann_json//:json",
        "@range-v3",
        "@yaml-cpp",
    ],
)

# ---------------------------------------------------------------------------
# Cap'n Proto code generation for Inspector RPC interface.
# ---------------------------------------------------------------------------

cc_capnp_library(
    name = "inspector_rpc_capnp",
    srcs = ["debug/inspector/rpc.capnp"],
)

# Python-based RPC server codegen — generates callback-based server
# implementation from the Cap'n Proto schema.
genrule(
    name = "inspector_rpc_server_gen",
    srcs = [
        "debug/inspector/rpc.capnp",
        "debug/inspector/generate_rpc_server.py",
    ],
    outs = [
        "debug/inspector/rpc_server_generated.hpp",
        "debug/inspector/rpc_server_generated.cpp",
    ],
    cmd = "$(execpath //tt_metal/impl:debug/inspector/generate_rpc_server.py) " +
          "$(execpath //tt_metal/impl:debug/inspector/rpc.capnp) " +
          "$(location debug/inspector/rpc_server_generated.hpp) " +
          "$(location debug/inspector/rpc_server_generated.cpp)",
)

