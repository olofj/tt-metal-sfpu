load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:cc_fbs.bzl", "cc_fbs_library")

# FlatBuffer schemas for the light-metal trace/replay system.
#
# Schema dependency chain (same directory, resolved via -I):
#   base_types.fbs
#   ├── program_types.fbs
#   │   └── buffer_types.fbs
#   │       └── command.fbs
#   │           └── light_metal_binary.fbs
cc_fbs_library(
    name = "flatbuffer_schemas",
    srcs = [
        "base_types.fbs",
        "buffer_types.fbs",
        "command.fbs",
        "light_metal_binary.fbs",
        "program_types.fbs",
    ],
    visibility = ["//tt_metal:__subpackages__"],
)

cc_test(
    name = "fbs_compile_test",
    srcs = ["fbs_compile_test.cpp"],
    deps = [
        ":flatbuffer_schemas",
        "@com_google_googletest//:gtest_main",
    ],
)
