load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:cc_fbs.bzl", "cc_fbs_library")

# FlatBuffer schemas for the light-metal trace/replay system.
#
# Schema dependency chain (same directory, resolved via -I):
#   base_types.fbs
#   ├── program_types.fbs
#   │   └── buffer_types.fbs
#   │       └── command.fbs
#   │           └── light_metal_binary.fbs
cc_fbs_library(
    name = "flatbuffer_schemas",
    srcs = [
        "base_types.fbs",
        "buffer_types.fbs",
        "command.fbs",
        "light_metal_binary.fbs",
        "program_types.fbs",
    ],
    visibility = ["//tt_metal:__subpackages__"],
)

# C++ serialization/deserialization headers for impl/.
# These are NOT generated — they are hand-written wrappers that include
# the generated FlatBuffer headers and provide typed conversion functions.
# Separated from impl_hdrs because this directory is a Bazel sub-package.
cc_library(
    name = "flatbuffer_hdrs",
    hdrs = glob(["*.hpp"]),
    # includes = [".."] puts impl/ on the include path so that
    # #include "flatbuffer/base_types_to_flatbuffer.hpp" resolves.
    includes = [".."],
    visibility = ["//tt_metal:__subpackages__"],
    deps = [
        ":flatbuffer_schemas",
    ],
)

# Source files for FlatBuffer serialization — consumed by //tt_metal/impl.
# These .cpp files are in this sub-package but compiled as part of the
# parent impl cc_library.
exports_files(
    [
        "base_types_from_flatbuffer.cpp",
        "base_types_to_flatbuffer.cpp",
        "buffer_types_from_flatbuffer.cpp",
        "buffer_types_to_flatbuffer.cpp",
        "program_types_from_flatbuffer.cpp",
        "program_types_to_flatbuffer.cpp",
    ],
    visibility = ["//tt_metal/impl:__pkg__"],
)

cc_test(
    name = "fbs_compile_test",
    srcs = ["fbs_compile_test.cpp"],
    deps = [
        ":flatbuffer_schemas",
        "@com_google_googletest//:gtest_main",
    ],
)
