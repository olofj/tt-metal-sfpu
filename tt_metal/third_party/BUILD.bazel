# Vendored third-party libraries that live as git submodules.
# BUILD files for http_archive deps are in //third_party/*.BUILD.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Tracy Profiler — vendored from https://github.com/tenstorrent-metal/tracy
#
# Without TRACY_ENABLE, all macros are no-ops and only headers are needed.
# With --config=tracy (-DTRACY_ENABLE), the TracyClient.cpp source is
# compiled and the full profiling infrastructure is linked in.
cc_library(
    name = "tracy",
    hdrs = glob([
        "tracy/public/tracy/**/*.hpp",
        "tracy/public/tracy/**/*.h",
        "tracy/public/common/**/*.hpp",
        "tracy/public/common/**/*.h",
        "tracy/public/client/**/*.hpp",
        "tracy/public/client/**/*.h",
    ]),
    includes = ["tracy/public"],
    visibility = ["//visibility:public"],
)

# TracyClient compiled library — used when TRACY_ENABLE is defined.
# This target compiles TracyClient.cpp (the single-translation-unit profiler
# implementation). Without --config=tracy the source is compiled but profiling
# macros expand to no-ops. The shared library is still produced for packaging
# consistency with CMake's libTracyClient.so.
cc_library(
    name = "tracy_client",
    # TracyClient.cpp is a unity-build file that #includes all other .cpp
    # files (common/TracySystem.cpp, client/TracyProfiler.cpp, etc.) using
    # paths relative to tracy/public/. Those .cpp files are listed as hdrs
    # (not srcs) so they are available in the sandbox for textual inclusion
    # without being compiled as separate translation units.
    srcs = ["tracy/public/TracyClient.cpp"],
    hdrs = glob([
        "tracy/public/common/*.cpp",
        "tracy/public/client/*.cpp",
    ]),
    copts = [
        "-Wno-error",
        "-DTRACY_TIMER_FALLBACK=1",
        "-Itt_metal/third_party/tracy/public",
    ],
    visibility = ["//visibility:public"],
    deps = [":tracy"],
)

# Tracy headers for .deb packaging (metalium-dev).
# Mirrors CMake install(FILES ...) rules in tracy/CMakeLists.txt that ship
# tracy/, client/, and common/ header directories.
filegroup(
    name = "deb_tracy_headers",
    srcs = glob([
        "tracy/public/tracy/**/*.hpp",
        "tracy/public/tracy/**/*.h",
        "tracy/public/common/**/*.hpp",
        "tracy/public/common/**/*.h",
        "tracy/public/client/**/*.hpp",
        "tracy/public/client/**/*.h",
    ]),
    visibility = ["//packaging:__pkg__"],
)

# TT LLK (Low-Level Kernel) headers bundled in the ttnn wheel.
# Exclude dotfiles: Python's glob.glob() (used by setup.py) skips dotfiles
# by default, so Bazel must explicitly exclude them to match.
filegroup(
    name = "wheel_data",
    srcs = glob(
        ["tt_llk*/**/*"],
        exclude = [
            "tt_llk*/**/.*",
            "tt_llk*/.github/**",
            "tt_llk/tests/**",
            "tt_llk/docs/**",
            "tt_llk/infra/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
