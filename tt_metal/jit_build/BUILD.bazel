# jit_build — header-only target for JIT build system headers.
#
# In CMake, jit_build/ is part of the monolithic tt_metal target.
# This header-only target makes the headers available to other Bazel
# targets (impl, etc.) that include them. The actual .cpp files will
# be added when jit_build/ gets its own full cc_library target
# (Phase 4: core tt_metal library).

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//tt_metal:__subpackages__"])

cc_library(
    name = "jit_build_hdrs",
    hdrs = glob(
        [
            "*.hpp",
            "*.h",
        ],
        allow_empty = True,
    ),
    includes = [".."],
    deps = [
        "//tt_metal/api:impl_api_hdrs",
        "//tt_metal/hostdevcommon",
        "//tt_metal/third_party/umd/device",
        "//tt_stl",
    ],
)
