# distributed — mesh device management, workloads, and multi-host support.
#
# Mirrors the CMake OBJECT library: distributed
# Contains ~25 source files for mesh device orchestration, command queues,
# socket communication, workload distribution, and multi-host contexts.
#
# MPI support: conditionally enabled via --config=distributed (or
# --define=enable_distributed=true). Without it, the single-host fallback
# is compiled. Mirrors CMake's ENABLE_DISTRIBUTED option.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//tt_metal:__subpackages__"])

# ---------------------------------------------------------------------------
# Feature flag: MPI / multi-host distributed compute
#
# Usage:
#   bazel build --config=distributed //tt_metal/...
#   bazel build --define=enable_distributed=true //tt_metal/...
# ---------------------------------------------------------------------------

config_setting(
    name = "enable_distributed",
    define_values = {"enable_distributed": "true"},
)

# ---------------------------------------------------------------------------
# Header-only subset — used by impl, fabric, and other libraries that need
# to include distributed headers without linking against the full .cpp library.
# ---------------------------------------------------------------------------

cc_library(
    name = "distributed_hdrs",
    hdrs = glob(
        [
            "*.hpp",
            "*.h",
        ],
        allow_empty = True,
    ),
    includes = [".."],
    deps = [
        "//tt_metal/api:impl_api_hdrs",
        "//tt_metal/hostdevcommon",
        "@umd//device",
        "//tt_stl",
    ],
)

# ---------------------------------------------------------------------------
# Full distributed library — all 25 source files.
#
# The multihost/ subdirectory contains the distributed context implementation.
# distributed_context.cpp uses #ifdef OPEN_MPI to select the implementation:
#   - With MPI:    mpi_distributed_context.cpp (full OpenMPI backend)
#   - Without MPI: single_host_context.cpp (single-host fallback)
# ---------------------------------------------------------------------------

cc_library(
    name = "distributed",
    srcs = [
        # Root sources
        "d2h_socket.cpp",
        "dispatch_context.cpp",
        "dummy_mesh_command_queue.cpp",
        "distributed.cpp",
        "distributed_coordinate_translator.cpp",
        "distributed_host_buffer.cpp",
        "fd_mesh_command_queue.cpp",
        "h2d_socket.cpp",
        "mesh_buffer.cpp",
        "mesh_command_queue_base.cpp",
        "mesh_device.cpp",
        "mesh_device_view.cpp",
        "mesh_event.cpp",
        "mesh_socket.cpp",
        "mesh_socket_serialization.cpp",
        "mesh_socket_utils.cpp",
        "mesh_trace.cpp",
        "mesh_workload.cpp",
        "mesh_workload_utils.cpp",
        "pinned_memory.cpp",
        "sd_mesh_command_queue.cpp",
        "system_mesh.cpp",
        "system_mesh_translation_map.cpp",
        # multihost/ — dispatcher + fallback (always compiled)
        "multihost/distributed_context.cpp",
        "multihost/single_host_context.cpp",
        # Private headers (not exported by distributed_hdrs)
        "multihost/single_host_context.hpp",
    ] + select({
        ":enable_distributed": [
            "multihost/mpi_distributed_context.cpp",
            "multihost/mpi_distributed_context.hpp",
        ],
        "//conditions:default": [],
    }),
    copts = [
        "-Wno-int-to-pointer-cast",
        # Source files use workspace-root-relative includes like
        # "tt_metal/distributed/mesh_socket_utils.hpp" and
        # "tt_metal/hw/inc/hostdev/socket.h".
        "-isystem",
        ".",
        # Generated FlatBuffer headers are at
        # $(GENDIR)/tt_metal/distributed/flatbuffer/socket_peer_descriptor_generated.h
        # Source files include them as "socket_peer_descriptor_generated.h".
        "-isystem",
        "$(GENDIR)/tt_metal/distributed/flatbuffer",
        "-isystem",
        "$(GENDIR)",
    ],
    local_defines = select({
        ":enable_distributed": ["OPEN_MPI=1"],
        "//conditions:default": [],
    }),
    deps = [
        ":distributed_hdrs",
        "//tt_metal/api:mesh_coordinate_cc_fbs",
        "//tt_metal/common",
        "//tt_metal/distributed/flatbuffer:flatbuffer_schemas",
        "//tt_metal/fabric:fabric_hdrs",
        "//tt_metal/impl:impl_hdrs",
        "//tt_metal/llrt:llrt_hdrs",
        "//tt_metal/third_party:tracy",
        "@umd//device",
        "@fmt",
        "@taskflow//:taskflow",
        "@tt_logger//:tt_logger",
    ] + select({
        ":enable_distributed": ["//third_party/system:openmpi"],
        "//conditions:default": [],
    }),
)
