# detail — header-only target for reports/memory_reporter and utils.
#
# In CMake, detail/ is a separate OBJECT library that links against impl.
# This header-only target makes the headers available to impl at compile
# time. The .cpp file (memory_reporter.cpp) will be added later.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//tt_metal:__subpackages__"])

cc_library(
    name = "detail_hdrs",
    hdrs = glob(
        [
            "**/*.hpp",
            "**/*.h",
        ],
        allow_empty = True,
    ),
    includes = [".."],
    deps = [
        "//tt_metal/api:impl_api_hdrs",
        "//tt_metal/impl:impl_hdrs",
    ],
)
