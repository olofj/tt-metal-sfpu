# detail — memory reporter and diagnostic utilities.
#
# Mirrors the CMake OBJECT library: detail
# Contains the MemoryReporter class for generating memory allocation
# statistics reports (DRAM, L1, L1_SMALL usage per program).
#
# In CMake, detail/ is a separate OBJECT library that links against
# common (PUBLIC) and impl + hostdevcommon (PRIVATE).
# The header-only target (detail_hdrs) breaks the circular dependency:
# impl depends on detail headers, and detail depends on impl headers.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//tt_metal:__subpackages__"])

# ---------------------------------------------------------------------------
# Header-only subset — breaks the impl <-> detail circular dependency.
#
# impl/ sources #include detail headers (reports/memory_reporter.hpp,
# reports/report_utils.hpp), and detail sources #include impl headers.
# This target exports all detail/ headers so impl can compile against them.
# ---------------------------------------------------------------------------

cc_library(
    name = "detail_hdrs",
    hdrs = glob(
        [
            "**/*.hpp",
            "**/*.h",
        ],
        allow_empty = True,
    ),
    includes = [".."],
    deps = [
        "//tt_metal/api:impl_api_hdrs",
        "//tt_metal/impl:impl_hdrs",
    ],
)

# ---------------------------------------------------------------------------
# Full detail library — memory_reporter.cpp.
# ---------------------------------------------------------------------------

cc_library(
    name = "detail",
    srcs = [
        "reports/memory_reporter.cpp",
    ],
    copts = [
        # memory_reporter.cpp uses workspace-root-relative includes like
        # "tt_metal/detail/reports/memory_reporter.hpp" and
        # "tt_metal/impl/allocator/allocator.hpp".
        "-isystem",
        ".",
        "-isystem",
        "$(GENDIR)",
    ],
    deps = [
        ":detail_hdrs",
        "//tt_metal/common",
        "//tt_metal/hostdevcommon",
        "@enchantum//:enchantum",
    ],
)
