# common — core data types and utilities for tt-metalium.
# Mirrors the CMake OBJECT library: TT::Metalium::Common
#
# This library provides fundamental types (CoreCoord, Shape, MeshCoord,
# HostBuffer, etc.) used throughout the tt-metal stack. In CMake it is
# built as an OBJECT library linked into the monolithic tt_metal target.
#
# Note: thread_pool.cpp is compiled in //tt_metal:tt_metal (the top-level
# library) because it depends on impl/ and llrt/ headers, creating a
# circular dependency if included here.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

exports_files(["thread_pool.cpp"])

cc_library(
    name = "common",
    srcs = [
        "core_assignment.cpp",
        "core_coord.cpp",
        "host_buffer.cpp",
        "memory_pin.cpp",
        "mesh_coord.cpp",
        "shape.cpp",
        "shape2d.cpp",
        "shape_base.cpp",
        "tt_backend_api_types.cpp",
        "work_split.cpp",
    ],
    hdrs = glob(
        [
            "*.hpp",
            "*.h",
        ],
        allow_empty = True,
    ),
    # thread_pool.cpp excluded: depends on impl/ and llrt/ (circular dep).
    # includes = [".."] adds tt_metal/ to the include path, matching CMake's
    # target_include_directories(common PUBLIC ${PROJECT_SOURCE_DIR}/tt_metal).
    # includes = ["."] adds tt_metal/common/ to the include path, matching CMake's
    # target_include_directories(common PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}).
    # Both are needed: "common/env_lib.hpp" resolves via "..", bare "env_lib.hpp" via ".".
    includes = [
        ".",
        "..",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Internal
        "//tt_metal/api:common_api_hdrs",
        "//tt_metal/hostdevcommon",
        "//tt_stl",
        "@umd//device",
        # External
        "@boost.core",
        "@enchantum//:enchantum",
        "@fmt",
        "@nlohmann_json//:json",
        "@simde//:simde",
        "@taskflow//:taskflow",
        "@tt_logger//:tt_logger",
        "@yaml-cpp",
        # Vendored
        "//tt_metal/third_party:tracy",
        # System
        "//third_party/system:numa",
    ],
)
