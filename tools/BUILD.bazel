# Python packages from tools/ for wheel packaging.
#
# The py_wheel strips "tools/" so:
#   tools/tracy/__init__.py  → tracy/__init__.py
#   tools/triage/triage.py   → triage/triage.py

load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "tracy",
    # tracy/ is a separate Bazel package (has its own BUILD.bazel);
    # re-export it so //tools:tracy still works for the wheel.
    srcs = glob(["tracy/**/*.py"], allow_empty = True),
    imports = ["."],
    deps = ["//tools/tracy"],
)

py_library(
    name = "triage",
    srcs = glob(["triage/**/*.py"]),
    imports = ["."],
)
