# scaleout_tools — scale-out topology and cabling management library.
#
# Mirrors the CMake OBJECT library: TT::ScaleoutTools
# Provides board definitions, cabling generators, connectors, factory system
# descriptor utilities, and node types for multi-chip topologies.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Export proto schema files so the protobuf/ sub-package can compile them.
exports_files([
    "cabling_descriptor/schemas/cluster_config.proto",
    "cabling_descriptor/schemas/node_config.proto",
    "deployment_descriptor/schemas/deployment.proto",
    "factory_system_descriptor/schemas/factory_system_descriptor.proto",
    "validation/schemas/ethernet_link_metrics.proto",
])

cc_library(
    name = "scaleout_tools",
    srcs = [
        "board/board.cpp",
        "cabling_generator/cabling_generator.cpp",
        "connector/connector.cpp",
        "factory_system_descriptor/utils.cpp",
        "node/node.cpp",
        "node/node_types.cpp",
    ],
    hdrs = [
        "board/board.hpp",
        "cabling_generator/cabling_generator.hpp",
        "connector/connector.hpp",
        "factory_system_descriptor/utils.hpp",
        "node/node.hpp",
        "node/node_types.hpp",
    ],
    copts = [
        # Generated proto headers live at $(GENDIR)/tools/scaleout/protobuf/*.pb.h.
        # Source code includes them as "protobuf/factory_system_descriptor.pb.h".
        "-isystem",
        "$(GENDIR)/tools/scaleout",
    ],
    # includes = ["."] adds tools/scaleout/ to include path so internal
    # headers resolve (e.g. <board/board.hpp>, <node/node_types.hpp>).
    includes = ["."],
    deps = [
        "//tools/scaleout/protobuf:scaleout_cc_proto",
        "//tt_metal/third_party/umd/device",
        "//tt_stl",
        "@enchantum//:enchantum",
        "@fmt",
        "@protobuf//:protobuf",
        "@tt_logger//:tt_logger",
        "@yaml-cpp",
    ],
)
