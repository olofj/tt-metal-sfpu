# ttnn Python package sources for wheel packaging.
#
# Used by the py_wheel target in the root BUILD.bazel.
# The py_wheel strips "ttnn/" so ttnn/ttnn/*.py → ttnn/*.py in the wheel.

load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# Copy _ttnn.so into this package directory so that `import ttnn._ttnn`
# resolves from the runfiles tree. The nanobind extension is built in the
# parent package (//ttnn:_ttnn.so) but Python expects it at ttnn/ttnn/_ttnn.so.
genrule(
    name = "_ttnn_so",
    srcs = ["//ttnn:_ttnn.so"],
    outs = ["_ttnn.so"],
    cmd = "cp $< $@",
)

# Copy split-module .so files into this package directory.
# These are additive — the monolithic _ttnn.so still works as before.
genrule(
    name = "_ttnn_core_so",
    srcs = ["//ttnn:_ttnn_core.so"],
    outs = ["_ttnn_core.so"],
    cmd = "cp $< $@",
)

# Per-operation split modules — one genrule per operation.
_TTNN_SPLIT_MODULES = [
    "bernoulli",
    "binary",
    "binary_backward",
    "ccl",
    "complex",
    "complex_unary",
    "complex_unary_backward",
    "conv",
    "copy",
    "creation",
    "data_movement",
    "debug",
    "embedding",
    "embedding_backward",
    "examples",
    "experimental",
    "full",
    "full_like",
    "generic",
    "index_fill",
    "kv_cache",
    "loss",
    "matmul",
    "moreh",
    "normalization",
    "point_to_point",
    "pool",
    "prefetcher",
    "quantization",
    "rand",
    "reduction",
    "sliding_window",
    "ternary",
    "ternary_backward",
    "transformer",
    "unary",
    "unary_backward",
    "uniform",
]

[genrule(
    name = "_ttnn_" + name + "_so",
    srcs = ["//ttnn:_ttnn_" + name + ".so"],
    outs = ["_ttnn_" + name + ".so"],
    cmd = "cp $< $@",
) for name in _TTNN_SPLIT_MODULES]

py_library(
    name = "ttnn_py",
    srcs = glob(["**/*.py"]),
    data = [":_ttnn_so"],
    imports = [".."],
)
