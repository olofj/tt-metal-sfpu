load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:cc_fbs.bzl", "cc_fbs_library")

# Export hand-written flatbuffer wrapper headers so ttnn_core can depend on them.
# These cannot be compiled here because they depend on core tensor types (circular).
cc_library(
    name = "flatbuffer_hdrs",
    hdrs = [
        "tensor_flatbuffer.hpp",
        "tensor_spec_flatbuffer.hpp",
    ],
    # "." puts ttnn/core/tensor/flatbuffer/ on the include path.
    # ".." puts ttnn/core/tensor/ so "flatbuffer/tensor_flatbuffer.hpp" resolves.
    includes = [".."],
    visibility = ["//ttnn:__subpackages__"],
    deps = [":flatbuffer_schemas"],
)

# Export source files for compilation by //ttnn:ttnn_core.
# They cannot be compiled here due to circular deps with core tensor types.
exports_files([
    "tensor_flatbuffer.cpp",
    "tensor_spec_flatbuffer.cpp",
])

# FlatBuffer schemas for tensor serialization.
#
# tensor_topology.fbs and tensor.fbs include mesh_coordinate.fbs from
# tt_metal/api via: include "tt-metalium/serialized_descriptors/mesh_coordinate.fbs"
cc_fbs_library(
    name = "flatbuffer_schemas",
    srcs = [
        "mesh_shape.fbs",
        "tensor.fbs",
        "tensor_spec.fbs",
        "tensor_topology.fbs",
    ],
    fbs_deps = ["//tt_metal/api:mesh_coordinate_fbs"],
    visibility = ["//ttnn:__subpackages__"],
)

cc_test(
    name = "fbs_compile_test",
    srcs = ["fbs_compile_test.cpp"],
    deps = [
        ":flatbuffer_schemas",
        "//tt_metal/api:mesh_coordinate_cc_fbs",
        "@com_google_googletest//:gtest_main",
    ],
)
