}

[nanobind_extension(
    name = "_ttnn_" + name,
    srcs = ["cpp/ttnn-nanobind/" + name + "_module.cpp", target + ":nanobind_srcs"],
    hdrs = glob(["cpp/ttnn-nanobind/**/*.hpp"]),
    deps = [":all_operations", target] + _TTNN_OP_EXTRA_DEPS.get(name, []),
) for name, target in _TTNN_OP_MODULES.items()]

