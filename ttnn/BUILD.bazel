    "//ttnn/cpp/ttnn/operations/moreh",
    "//ttnn/cpp/ttnn/operations/normalization",
    "//ttnn/cpp/ttnn/operations/point_to_point",
    "//ttnn/cpp/ttnn/operations/pool",
    "//ttnn/cpp/ttnn/operations/prefetcher",
    "//ttnn/cpp/ttnn/operations/rand",
    "//ttnn/cpp/ttnn/operations/reduction",
