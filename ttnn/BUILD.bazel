# ttnn — top-level package for the TT-NN operations framework.
#
# Provides:
#   - ttnn_core: The TTNN core library (mirrors CMake TTNN::Core)
#   - _ttnn.so: The nanobind Python extension module (mirrors CMake _ttnn)
#   - tt_lib_py: tt_lib Python package (for wheel packaging)
#   - jit_headers: JIT compilation headers (for wheel packaging)

load("//bazel:nanobind_extension.bzl", "nanobind_extension")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ttnn_core",
    srcs = [
        "core/async_runtime.cpp",
        "core/cluster.cpp",
        "core/config.cpp",
        "core/core.cpp",
        "core/device.cpp",
        "core/distributed/api.cpp",
        "core/distributed/bidirectional_fabric_socket.cpp",
        "core/distributed/create_socket.cpp",
        "core/distributed/distributed_tensor.cpp",
        "core/distributed/distribution_mode.cpp",
        "core/distributed/fabric_socket.cpp",
        "core/distributed/host_ccl.cpp",
        "core/distributed/mpi_socket.cpp",
        "core/events.cpp",
        "core/global_circular_buffer.cpp",
        "core/global_semaphore.cpp",
        "core/graph/graph_argument_serializer.cpp",
        "core/graph/graph_processor.cpp",
        "core/graph/graph_trace_utils.cpp",
        "core/graph/levelized_graph.cpp",
        "core/operation.cpp",
        "core/reports.cpp",
        # These live in the //ttnn/core/tensor/flatbuffer subpackage but must
        # be compiled here because they depend on core tensor types (circular).
        "//ttnn/core/tensor/flatbuffer:tensor_flatbuffer.cpp",
        "//ttnn/core/tensor/flatbuffer:tensor_spec_flatbuffer.cpp",
        "core/tensor/host_buffer/functions.cpp",
        "core/tensor/serialization.cpp",
        "core/tensor/storage.cpp",
        "core/tensor/tensor.cpp",
        "core/tensor/tensor_attributes.cpp",
        "core/tensor/tensor_impl.cpp",
        "core/tensor/tensor_ops.cpp",
        "core/tensor/tensor_utils.cpp",
        "core/tensor/to_string.cpp",
        "core/tensor/unit_mesh/unit_mesh_utils.cpp",
        "core/tensor/xtensor/partition.cpp",
        "core/tensor/py_to_tt_tensor.cpp",
    ],
    hdrs =
        # All headers in the ttnn package. The glob automatically stops at
        # subpackage boundaries (directories with their own BUILD.bazel),
        # so operation headers under cpp/ttnn/operations/*/ are NOT included.
        # Those are accessed via _hdrs deps listed below.
        glob(
            [
                "api/**/*.hpp",
                "core/**/*.hpp",
                "cpp/ttnn/**/*.hpp",
                "cpp/ttnn/**/*.h",
            ],
            exclude = [
                # Subpackage — has its own BUILD.bazel
                "core/tensor/flatbuffer/**",
                # Kernel files handled by the second glob below.
                "cpp/ttnn/kernel/**",
            ],
            allow_empty = True,
        ) +
        # Device kernel files shipped as headers for JIT compilation at runtime.
        # These .cpp/.hpp files under kernel/ are NOT compiled by the host —
        # they are FILE_SET kernels (TYPE HEADERS) in CMake.
        glob(
            ["cpp/ttnn/kernel/**"],
            allow_empty = True,
        ),
    copts = [
        "-Wno-c++11-narrowing",
        "-Wno-unused-lambda-capture",
        "-isystem",
        ".",
        "-isystem",
        "$(GENDIR)",
    ],
    # These include paths replicate CMake's FixmeOpAPIDir and FixmeOpIncDirs:
    #   - "cpp" makes #include "ttnn/operations/matmul/matmul.hpp" resolve
    #     (because headers live at ttnn/cpp/ttnn/operations/...)
    #   - "." makes #include from within ttnn/ resolve (FixmeOpIncDirs includes ttnn/)
    #   - "api" makes #include "ttnn/tensor/layout/layout.hpp" resolve
    #     (the api/ directory mirrors the public header tree)
    #   - "core" makes core-relative includes resolve
    includes = [
        ".",
        "api",
        "api/ttnn",
        "core",
        "cpp",
    ],
    deps = [
        "//tt_metal:tt_metal",
        "//ttnn/core/tensor/flatbuffer:flatbuffer_hdrs",
        "//ttnn/core/tensor/flatbuffer:flatbuffer_schemas",
        # Operation _hdrs targets needed because ttnn_core source files
        # include operation headers (a legacy circular dependency from CMake).
        # The _hdrs targets are dependency-free, so no cycle is created.
        "//ttnn/cpp/ttnn/operations/core:core_hdrs",
        "//ttnn/cpp/ttnn/operations/data_movement:data_movement_hdrs",
        "//ttnn/cpp/ttnn/operations/experimental/ccl:ccl_hdrs",
        "@boost.algorithm",
        "@flatbuffers//:flatbuffers",
        "@fmt",
        "@nlohmann_json//:json",
        "@xtensor//:xtensor",
    ],
)

# ===========================================================================
# _ttnn — nanobind Python extension module
#
# Compiles all nanobind binding sources and links them into _ttnn.so,
# loadable via `import _ttnn`. Mirrors the CMake target defined in
# ttnn/CMakeLists.txt lines 729-847 (the WITH_PYTHON_BINDINGS block).
#
# Sources come from three locations:
#   1. cpp/ttnn-nanobind/ — core binding module (__init__.cpp, tensor.cpp, etc.)
#   2. cpp/ttnn/operations/**/*_nanobind.cpp — per-operation bindings (via filegroups)
#   3. core/{distributed,graph}/*_nanobind.cpp — core subsystem bindings
# ===========================================================================

# Operation targets with nanobind binding sources (*_nanobind.cpp files).
# The _ttnn extension compiles these bindings and links the operation libraries.
# Operations WITHOUT nanobind sources (binary_ng, complex_binary) are listed
# separately in _TTNN_LINK_ONLY_OPS — they are linked but have no bindings.
_TTNN_NANOBIND_OPS = [
    "//ttnn/cpp/ttnn/operations/bernoulli",
    "//ttnn/cpp/ttnn/operations/ccl",
    "//ttnn/cpp/ttnn/operations/conv",
    "//ttnn/cpp/ttnn/operations/data_movement",
    "//ttnn/cpp/ttnn/operations/debug",
    "//ttnn/cpp/ttnn/operations/eltwise/binary",
    "//ttnn/cpp/ttnn/operations/eltwise/binary_backward",
    "//ttnn/cpp/ttnn/operations/eltwise/complex",
    "//ttnn/cpp/ttnn/operations/eltwise/complex_unary",
    "//ttnn/cpp/ttnn/operations/eltwise/complex_unary_backward",
    "//ttnn/cpp/ttnn/operations/eltwise/quantization",
    "//ttnn/cpp/ttnn/operations/eltwise/ternary",
    "//ttnn/cpp/ttnn/operations/eltwise/ternary_backward",
    "//ttnn/cpp/ttnn/operations/eltwise/unary",
    "//ttnn/cpp/ttnn/operations/eltwise/unary_backward",
    "//ttnn/cpp/ttnn/operations/embedding",
    "//ttnn/cpp/ttnn/operations/embedding_backward",
    "//ttnn/cpp/ttnn/operations/examples",
    "//ttnn/cpp/ttnn/operations/full",
    "//ttnn/cpp/ttnn/operations/full_like",
    "//ttnn/cpp/ttnn/operations/generic",
    "//ttnn/cpp/ttnn/operations/index_fill",
    "//ttnn/cpp/ttnn/operations/kv_cache",
    "//ttnn/cpp/ttnn/operations/loss",
    "//ttnn/cpp/ttnn/operations/matmul",
    "//ttnn/cpp/ttnn/operations/moreh",
    "//ttnn/cpp/ttnn/operations/normalization",
    "//ttnn/cpp/ttnn/operations/point_to_point",
    "//ttnn/cpp/ttnn/operations/pool",
    "//ttnn/cpp/ttnn/operations/prefetcher",
    "//ttnn/cpp/ttnn/operations/rand",
    "//ttnn/cpp/ttnn/operations/reduction",
    "//ttnn/cpp/ttnn/operations/sliding_window",
    "//ttnn/cpp/ttnn/operations/transformer",
    "//ttnn/cpp/ttnn/operations/uniform",
    # Experimental operations:
    "//ttnn/cpp/ttnn/operations/experimental/adaptive_pool",
    "//ttnn/cpp/ttnn/operations/experimental/deepseek/moe/moe_gate_mm",
    "//ttnn/cpp/ttnn/operations/experimental/bcast_to",
    "//ttnn/cpp/ttnn/operations/experimental/ccl",
    "//ttnn/cpp/ttnn/operations/experimental/cnn",
    "//ttnn/cpp/ttnn/operations/experimental/conv3d",
    "//ttnn/cpp/ttnn/operations/experimental/copy",
    "//ttnn/cpp/ttnn/operations/experimental/dropout",
    "//ttnn/cpp/ttnn/operations/experimental/isin",
    "//ttnn/cpp/ttnn/operations/experimental/matmul",
    "//ttnn/cpp/ttnn/operations/experimental/minimal_matmul",
    "//ttnn/cpp/ttnn/operations/experimental/padded_slice",
    "//ttnn/cpp/ttnn/operations/experimental/paged_cache",
    "//ttnn/cpp/ttnn/operations/experimental/plusone",
    "//ttnn/cpp/ttnn/operations/experimental/reduction",
    "//ttnn/cpp/ttnn/operations/experimental/reshape",
    "//ttnn/cpp/ttnn/operations/experimental/slice_write",
    "//ttnn/cpp/ttnn/operations/experimental/ssm",
    "//ttnn/cpp/ttnn/operations/experimental/test",
    "//ttnn/cpp/ttnn/operations/experimental/transformer",
    "//ttnn/cpp/ttnn/operations/experimental/unary_backward",
    "//ttnn/cpp/ttnn/operations/experimental/where",
]

# Operations that are linked into _ttnn but have no nanobind binding sources.
_TTNN_LINK_ONLY_OPS = [
    "//ttnn/cpp/ttnn/operations/eltwise/binary_ng",
    "//ttnn/cpp/ttnn/operations/eltwise/complex_binary",
]

nanobind_extension(
    name = "_ttnn",
    srcs =
        # Core nanobind module: entry point (__init__.cpp with NB_MODULE) plus
        # type/tensor/device/cluster bindings.
        glob(["cpp/ttnn-nanobind/**/*.cpp"]) +
        # Core subsystem nanobind bindings (not in operation sub-packages).
        [
            "core/distributed/distributed_nanobind.cpp",
            "core/graph/graph_nanobind.cpp",
        ] +
        # Experimental top-level nanobind (not in a sub-package).
        glob(
            ["cpp/ttnn/operations/experimental/*_nanobind.cpp"],
            allow_empty = True,
        ) +
        # Per-operation nanobind bindings from sub-packages (via filegroups
        # generated by ttnn_operation() macro).
        [op + ":nanobind_srcs" for op in _TTNN_NANOBIND_OPS],
    hdrs = glob(["cpp/ttnn-nanobind/**/*.hpp"]),
    copts = [
        "-Wno-c++11-narrowing",
        "-Wno-unused-lambda-capture",
    ],
    deps = [
        # Core TTNN library (provides tensor, device, graph, distributed types).
        ":ttnn_core",
        # The core operation uses plain cc_library (not ttnn_operation macro).
        "//ttnn/cpp/ttnn/operations/core",
        # External deps (matches CMake: target_link_libraries(ttnn PRIVATE Boost::algorithm)).
        "@boost.algorithm",
    ] + _TTNN_NANOBIND_OPS + _TTNN_LINK_ONLY_OPS,
    visibility = ["//visibility:public"],
)

# ===========================================================================
# Python packages and data files for wheel packaging
# ===========================================================================

# tt_lib Python package — bundled alongside ttnn in the wheel.
# Lives at ttnn/tt_lib/ in the workspace; strip_path_prefixes=["ttnn/"]
# maps it to tt_lib/ in the wheel (matching setup.py package_dir).
py_library(
    name = "tt_lib_py",
    srcs = glob(["tt_lib/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)

# JIT compilation headers shipped inside the wheel for runtime kernel
# compilation on device. These are NOT compiled by the host build — they
# are source files bundled as data.
#
# Matches setup.py ttnn_cpp_patterns (lines 334-344):
#   ttnn/kernel/**, ttnn/operations/**/kernels/**, etc.
#
# Files in the ttnn/ package (not in subpackages) are globbed directly.
# Files in operation subpackages come from :wheel_kernel_data targets
# generated by the ttnn_operation() macro.
filegroup(
    name = "jit_headers",
    srcs = glob(
        [
            "cpp/ttnn/kernel/**",
        ],
        allow_empty = True,
    ) + [op + ":wheel_kernel_data" for op in _TTNN_NANOBIND_OPS + _TTNN_LINK_ONLY_OPS] + [
        "//ttnn/cpp/ttnn/operations/core:wheel_kernel_data",
        "//ttnn/cpp/ttnn/operations/kernel_helper_functions:wheel_kernel_data",
    ],
    visibility = ["//visibility:public"],
)
