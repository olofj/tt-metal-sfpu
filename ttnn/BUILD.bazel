# ===========================================================================
# all_operations — aggregate target for linking all TTNN operations.
#
# C++ consumers of TTNN (e.g., tt-train) that call operation functions need
# their compiled implementations linked in. This target aggregates all
# operation libraries so downstream cc_binary/cc_test targets can link them
# without listing individual operations.
# ===========================================================================

cc_library(
    name = "all_operations",
    visibility = ["//visibility:public"],
    deps = [
        ":ttnn_core",
        "//ttnn/cpp/ttnn/operations/core",
    ] + _TTNN_NANOBIND_OPS + _TTNN_LINK_ONLY_OPS,
)

# ===========================================================================
# _ttnncpp.so — C++ shared library for SDK consumers and .deb packaging
#
# Mirrors the CMake target: ttnncpp (SHARED), installed as _ttnncpp.so.
# Aggregates ttnn_core and all operation libraries, linking against
# libtt_metal.so (and its transitive dynamic deps) at runtime.
# CMake uses PREFIX="_" producing "_ttnncpp.so" for Python interop.
#
# Defined here (not in //packaging) because the operation targets have
# package-private visibility (//ttnn:__subpackages__).
# ===========================================================================

cc_shared_library(
    name = "ttnncpp_shared",
    deps = [
        ":ttnn_core",
        "//ttnn/cpp/ttnn/operations/core",
    ] + _TTNN_NANOBIND_OPS + _TTNN_LINK_ONLY_OPS,
    dynamic_deps = ["//packaging:libtt_metal.so"],
    exports_filter = [
        "//ttnn:__subpackages__",
    ],
    shared_lib_name = "_ttnncpp.so",
    visibility = ["//visibility:public"],
)

# ===========================================================================
# Python packages and data files for wheel packaging
# ===========================================================================

# tt_lib Python package — bundled alongside ttnn in the wheel.
# Lives at ttnn/tt_lib/ in the workspace; strip_path_prefixes=["ttnn/"]
# maps it to tt_lib/ in the wheel (matching setup.py package_dir).
py_library(
    name = "tt_lib_py",
    srcs = glob(["tt_lib/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)

# JIT compilation headers shipped inside the wheel for runtime kernel
# compilation on device. These are NOT compiled by the host build — they
# are source files bundled as data.
#
# Matches setup.py ttnn_cpp_patterns (lines 334-344):
#   ttnn/kernel/**, ttnn/operations/**/kernels/**, etc.
#
# Files in the ttnn/ package (not in subpackages) are globbed directly.
# Files in operation subpackages come from :wheel_kernel_data targets
# generated by the ttnn_operation() macro.
filegroup(
    name = "jit_headers",
    srcs = glob(
        [
            "cpp/ttnn/kernel/**",
        ],
        allow_empty = True,
    ) + [op + ":wheel_kernel_data" for op in _TTNN_NANOBIND_OPS + _TTNN_LINK_ONLY_OPS] + [
        "//ttnn/cpp/ttnn/operations/core:wheel_kernel_data",
        "//ttnn/cpp/ttnn/operations/kernel_helper_functions:wheel_kernel_data",
    ],
    visibility = ["//visibility:public"],
)

# TTNN public API headers for .deb packaging (nn-dev).
# Mirrors CMake FILE_SET api on the ttnncpp target.
filegroup(
    name = "deb_headers",
    srcs = glob(
        [
            "api/**/*.hpp",
            "api/**/*.h",
            "cpp/ttnn/**/*.hpp",
            "cpp/ttnn/**/*.h",
        ],
        exclude = [
            # Kernel sources are runtime data, not dev headers.
            "cpp/ttnn/kernel/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//packaging:__pkg__"],
)
