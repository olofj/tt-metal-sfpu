# Operations that are linked into _ttnn but have no nanobind binding sources.
_TTNN_LINK_ONLY_OPS = [
    "//ttnn/cpp/ttnn/operations/copy",
    "//ttnn/cpp/ttnn/operations/eltwise/binary_ng",
    "//ttnn/cpp/ttnn/operations/eltwise/complex_binary",
]

nanobind_extension(
    name = "_ttnn",
    srcs =
        # Core nanobind module: entry point (__init__.cpp with NB_MODULE) plus
        # type/tensor/device/cluster bindings.
        glob(["cpp/ttnn-nanobind/**/*.cpp"]) +
        # Core subsystem nanobind bindings (not in operation sub-packages).
        [
            "core/distributed/distributed_nanobind.cpp",
            "core/graph/graph_nanobind.cpp",
        ] +
        # Experimental top-level nanobind (not in a sub-package).
        glob(
            ["cpp/ttnn/operations/experimental/*_nanobind.cpp"],
            allow_empty = True,
        ) +
        # Per-operation nanobind bindings from sub-packages (via filegroups
        # generated by ttnn_operation() macro).
        [op + ":nanobind_srcs" for op in _TTNN_NANOBIND_OPS],
    hdrs = glob(["cpp/ttnn-nanobind/**/*.hpp"]),
    copts = [
        "-Wno-c++11-narrowing",
        "-Wno-unused-lambda-capture",
    ],
    deps = [
        # Core TTNN library (provides tensor, device, graph, distributed types).
        ":ttnn_core",
        # The core operation uses plain cc_library (not ttnn_operation macro).
        "//ttnn/cpp/ttnn/operations/core",
        # External deps (matches CMake: target_link_libraries(ttnn PRIVATE Boost::algorithm)).
        "@boost.algorithm",
    ] + _TTNN_NANOBIND_OPS + _TTNN_LINK_ONLY_OPS,
    visibility = ["//visibility:public"],
)

# ===========================================================================
# _ttnn_core — core-only nanobind module (types + core functions, no ops)
#
# Prototype for splitting _ttnn.so into smaller modules. Binds all types
# (Tensor, Device, MemoryConfig, etc.) and core functions, plus
# operations::core (DeviceComputeKernelConfig) and operations::trace
# (MeshTraceId) type definitions. Does NOT bind any operation functions.
#
# Per-operation modules (e.g., _ttnn_bernoulli) share types with _ttnn_core
# via nanobind's NB_DOMAIN cross-module mechanism.
# ===========================================================================

nanobind_extension(
    name = "_ttnn_core",
    srcs =
        # Core module entry point (replaces __init__.cpp's NB_MODULE).
        ["cpp/ttnn-nanobind/core_module.cpp"] +
        # All type/tensor/device/cluster binding sources EXCEPT:
        #   - __init__.cpp (replaced by core_module.cpp)
        #   - operations/__init__.cpp (the 40+ operation dispatcher)
        #   - operations/copy.cpp, operations/creation.cpp (operation bindings, not types)
        glob(
            ["cpp/ttnn-nanobind/**/*.cpp"],
            exclude = [
                "cpp/ttnn-nanobind/__init__.cpp",
                "cpp/ttnn-nanobind/*_module.cpp",
                "cpp/ttnn-nanobind/operations/__init__.cpp",
                "cpp/ttnn-nanobind/operations/copy.cpp",
                "cpp/ttnn-nanobind/operations/creation.cpp",
            ],
        ) +
        # Core subsystem nanobind bindings.
        [
            "core/distributed/distributed_nanobind.cpp",
            "core/graph/graph_nanobind.cpp",
        ],
    hdrs = glob(["cpp/ttnn-nanobind/**/*.hpp"]),
    deps = [
        ":ttnn_core",
        "//ttnn/cpp/ttnn/operations/core",
        # ttnn_core source files (tensor_ops.cpp, device.cpp, etc.) call into
        # these operations via _hdrs includes. The monolithic _ttnn.so links
        # everything so these resolve; the split _ttnn_core.so needs them
        # explicitly to avoid undefined symbols at runtime.
        "//ttnn/cpp/ttnn/operations/ccl",
        "//ttnn/cpp/ttnn/operations/copy",
        "//ttnn/cpp/ttnn/operations/data_movement",
        "//ttnn/cpp/ttnn/operations/experimental/reshape",
    ],
)

# ===========================================================================
