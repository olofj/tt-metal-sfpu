load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Kernel headers/sources bundled in the ttnn wheel for JIT compilation.
filegroup(
    name = "wheel_kernel_data",
    srcs = glob(
        ["kernels/**", "kernels_ng/**"],
        allow_empty = True,
    ),
    visibility = ["//ttnn:__subpackages__"],
)

# Interface-only library: provides pad_tile.hpp as a device kernel header
# (shipped to device for JIT compilation, not compiled by host).
cc_library(
    name = "kernel_helper_functions",
    hdrs = ["pad_tile.hpp"],
    visibility = ["//ttnn:__subpackages__"],
)
