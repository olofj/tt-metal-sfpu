"""Repository rule to expose the UMD submodule as an external Bazel repo.

Creates a symlink forest of the UMD submodule at tt_metal/third_party/umd,
overlaying BUILD files from the main repo.  This keeps the submodule
working tree clean (no modified/untracked BUILD files) while providing
Bazel build targets at @umd//device and @umd//src.

Follows the same pattern as toolchain/clang/repo.bzl and
toolchain/sfpi/repo.bzl.
"""

def _umd_local_repository_impl(ctx):
    # Resolve workspace-relative path to absolute.
    workspace_root = str(ctx.path(Label("@//:MODULE.bazel")).dirname)
    umd_path = workspace_root + "/" + ctx.attr.path

    # Top-level entries that need BUILD overlays — symlink their contents
    # individually so we can skip any BUILD files from the submodule.
    _overlay_dirs = ["device", "src"]

    # Symlink all top-level entries except the overlay dirs.
    res = ctx.execute(["ls", "-A", umd_path])
    if res.return_code != 0:
        fail("Cannot list UMD directory: " + res.stderr)

    for entry in res.stdout.strip().split("\n"):
        if entry in _overlay_dirs:
            continue
        ctx.symlink(umd_path + "/" + entry, entry)

    # For overlay dirs, symlink contents but skip BUILD/BUILD.bazel files.
    for dirname in _overlay_dirs:
        src_dir = umd_path + "/" + dirname
        res = ctx.execute(["ls", "-A", src_dir])
        if res.return_code != 0:
            fail("Cannot list {}: {}".format(src_dir, res.stderr))

        for entry in res.stdout.strip().split("\n"):
            if entry in ("BUILD", "BUILD.bazel"):
                continue
            ctx.symlink(src_dir + "/" + entry, dirname + "/" + entry)

    # Write root BUILD.bazel (alias to device library).
    ctx.file("BUILD.bazel", content = _ROOT_BUILD)

    # Write device/BUILD.bazel from the overlay template.
    ctx.file("device/BUILD.bazel", content = ctx.read(ctx.attr._device_build))

    # Write src/BUILD.bazel (firmware headers).
    ctx.file("src/BUILD.bazel", content = _SRC_BUILD)

_ROOT_BUILD = """\
# UMD (User Mode Driver) — Bazel build targets.
# Auto-generated by //third_party/umd:repo.bzl — do not edit.

alias(
    name = "device",
    actual = "//device",
    visibility = ["//visibility:public"],
)
"""

_SRC_BUILD = """\
# UMD firmware — header-only RISC-V firmware definitions.
# Auto-generated by //third_party/umd:repo.bzl — do not edit.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "firmware",
    hdrs = glob(["firmware/riscv/**/*.h"]),
    includes = ["firmware/riscv"],
    visibility = ["//visibility:public"],
)
"""

umd_local_repository = repository_rule(
    implementation = _umd_local_repository_impl,
    attrs = {
        "path": attr.string(mandatory = True, doc = "Workspace-relative path to UMD submodule"),
        "_device_build": attr.label(
            default = "//third_party/umd:device.BUILD",
            allow_single_file = True,
        ),
    },
    local = True,
)
