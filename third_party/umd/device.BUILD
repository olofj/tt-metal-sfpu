# UMD device library — the User Mode Driver for Tenstorrent hardware.
# Mirrors the CMake target: umd::device
#
# UMD uses C++17 while the rest of tt-metal uses C++20.
# The copts override the global --cxxopt=-std=c++20 from .bazelrc.
#
# Auto-generated by //third_party/umd:repo.bzl — do not edit directly.
# Source of truth: //third_party/umd/device.BUILD

load("@tt-metalium//bazel:cc_fbs.bzl", "cc_fbs_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# FlatBuffers codegen for the simulation device protocol.
# Generates simulation/simulation_device_generated.h from the .fbs schema.
# Source files include it as bare "simulation_device_generated.h", so we
# create a wrapper cc_library with includes pointing to the simulation/ subdir.
cc_fbs_library(
    name = "simulation_device_fbs_raw",
    srcs = ["simulation/simulation_device.fbs"],
    # UMD uses unscoped enum names (e.g., DEVICE_COMMAND_WRITE, not
    # DEVICE_COMMAND::WRITE), matching CMake's `flatc --cpp` without
    # --scoped-enums (see CMakeLists.txt line 18).
    scoped_enums = False,
)

cc_library(
    name = "simulation_device_fbs",
    hdrs = [":simulation_device_fbs_raw_gen"],
    includes = ["simulation"],
    deps = ["@flatbuffers//:flatbuffers"],
)

# The kernel module driver binding is C (not C++). Because the toolchain
# routes all compilation through g++/clang++, this C file gets compiled as
# C++. The -fpermissive flag allows the implicit void* casts from malloc().
cc_library(
    name = "tt_kmd_lib",
    srcs = [
        "pcie/ioctl.h",
        "tt_kmd_lib/tt_kmd_lib.c",
    ],
    hdrs = ["api/umd/device/tt_kmd_lib/tt_kmd_lib.h"],
    copts = [
        # Force C compilation — this file uses implicit void* casts from
        # malloc() that are valid C but invalid C++.
        "-x",
        "c",
        "-std=c17",
        "-D_GNU_SOURCE",
        "-Wno-error",
    ],
    includes = ["api", ".", "common"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "device",
    srcs = [
        # Top-level
        "cluster.cpp",
        "cluster_descriptor.cpp",
        "cpuset_lib.cpp",
        "hugepage.cpp",
        "noc_access.cpp",
        "soc_descriptor.cpp",
        "warm_reset.cpp",
        # arc/
        "arc/arc_messenger.cpp",
        "arc/arc_telemetry_reader.cpp",
        "arc/blackhole_arc_message_queue.cpp",
        "arc/blackhole_arc_messenger.cpp",
        "arc/blackhole_arc_telemetry_reader.cpp",
        "arc/smbus_arc_telemetry_reader.cpp",
        "arc/spi_tt_device.cpp",
        "arc/wormhole_arc_messenger.cpp",
        "arc/wormhole_arc_telemetry_reader.cpp",
        "arc/wormhole_spi_tt_device.cpp",
        # arch/
        "arch/architecture_implementation.cpp",
        "arch/blackhole_implementation.cpp",
        "arch/grendel_implementation.cpp",
        "arch/wormhole_implementation.cpp",
        # chip/
        "chip/chip.cpp",
        "chip/local_chip.cpp",
        "chip/mock_chip.cpp",
        "chip/remote_chip.cpp",
        # simulation/ — matches CMake's TT_UMD_BUILD_SIMULATION=ON (the default
        # for tt-metal's top-level build, set in cmake/project_options.cmake).
        "simulation/simulation_chip.cpp",
        "simulation/tt_sim_chip.cpp",
        "simulation/rtl_simulation_chip.cpp",
        "simulation/simulation_host.cpp",
        # tt_device/ simulation backends
        "tt_device/tt_sim_tt_device.cpp",
        "tt_device/rtl_simulation_tt_device.cpp",
        # chip_helpers/
        "chip_helpers/silicon_sysmem_manager.cpp",
        "chip_helpers/simulation_sysmem_manager.cpp",
        "chip_helpers/sysmem_buffer.cpp",
        "chip_helpers/sysmem_manager.cpp",
        "chip_helpers/tlb_manager.cpp",
        # coordinates/
        "coordinates/blackhole_coordinate_manager.cpp",
        "coordinates/coordinate_manager.cpp",
        "coordinates/wormhole_coordinate_manager.cpp",
        # firmware/
        "firmware/blackhole_18_7_firmware_info_provider.cpp",
        "firmware/firmware_info_provider.cpp",
        "firmware/firmware_utils.cpp",
        "firmware/wormhole_18_3_firmware_info_provider.cpp",
        "firmware/wormhole_18_7_firmware_info_provider.cpp",
        # jtag/
        "jtag/jtag.cpp",
        "jtag/jtag_device.cpp",
        # logging/
        "logging/config.cpp",
        # pcie/
        "pcie/pci_device.cpp",
        "pcie/tlb_handle.cpp",
        "pcie/tlb_window.cpp",
        # topology/
        "topology/topology_discovery.cpp",
        "topology/topology_discovery_blackhole.cpp",
        "topology/topology_discovery_wormhole.cpp",
        # tt_device/
        "tt_device/blackhole_tt_device.cpp",
        "tt_device/remote_communication.cpp",
        "tt_device/remote_communication_legacy_firmware.cpp",
        "tt_device/remote_wormhole_tt_device.cpp",
        "tt_device/tt_device.cpp",
        "tt_device/wormhole_tt_device.cpp",
        # types/
        "types/risc_type.cpp",
        "types/tensix_soft_reset_options.cpp",
        "types/tlb.cpp",
        "types/xy_pair.cpp",
        # utils/
        "utils/lock_manager.cpp",
        "utils/robust_mutex.cpp",
    ] + glob(
        # Private headers (not under api/) used by the implementation
        [
            "common/*.hpp",
            "cpuset_lib.hpp",
            "hugepage.hpp",
            "noc_access.hpp",
            "pcie/ioctl.h",
        ],
    ),
    hdrs = glob(["api/**/*.hpp", "api/**/*.h"]),
    copts = [
        # UMD requires C++17; override the global C++20 from .bazelrc.
        "-std=c++17",
        "-Wno-sign-compare",
        "-Wno-unused-function",
        # Simulation support (matches CMake's TT_UMD_BUILD_SIMULATION=ON default).
        "-DTT_UMD_BUILD_SIMULATION",
    ],
    includes = ["api", ".", "common"],
    linkopts = [
        "-ldl",
        "-lrt",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":simulation_device_fbs",
        ":tt_kmd_lib",
        "//src:firmware",
        "@tt-metalium//third_party/system:hwloc",
        "@asio",
        "@flatbuffers//:flatbuffers",
        "@fmt",
        "@libuv",
        "@nng",
        "@picosha2",
        "@spdlog",
        "@tt_logger//:tt_logger",
        "@yaml-cpp",
    ],
)
