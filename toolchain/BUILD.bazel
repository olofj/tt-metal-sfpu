"""Host C++ toolchain definitions matching CMake toolchain files.

Toolchain variants:
  clang20-libcpp     — cmake/x86_64-linux-clang-20-libcpp-toolchain.cmake
  clang20-libstdcpp  — cmake/x86_64-linux-clang-20-libstdcpp-toolchain.cmake
  gcc12              — cmake/x86_64-linux-gcc-12-toolchain.cmake
  gcc14              — cmake/x86_64-linux-gcc-14-toolchain.cmake

Linker selection mirrors cmake/linking.cmake: prefer mold, then LLD, then ld.
Use --config=<name> in .bazelrc to select a toolchain.
"""

load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# ===================================================================
# Filegroups (Bazel requires these for cc_toolchain)
# ===================================================================

filegroup(
    name = "empty",
    srcs = [],
)

# ===================================================================
# Clang 20 + libc++
# ===================================================================

cc_toolchain_config(
    name = "clang20_libcpp_config",
    compiler = "clang",
    compiler_version = "20",
    stdlib = "libc++",
    cc_path = "/usr/bin/clang-20",
    cxx_path = "/usr/bin/clang++-20",
    linker_path = "/usr/bin/ld.mold",
    cxx_builtin_include_directories = [
        "/usr/lib/llvm-20/include/c++/v1",
        "/usr/lib/llvm-20/lib/clang/20/include",
        "/usr/include",
    ],
)

cc_toolchain(
    name = "clang20_libcpp_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":clang20_libcpp_config",
)

toolchain(
    name = "clang20_libcpp",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":clang20_libcpp_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

