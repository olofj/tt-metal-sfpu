"""Host C++ toolchain definitions matching CMake toolchain files.

Toolchain variants (system-installed, non-hermetic):
  gcc12              — cmake/x86_64-linux-gcc-12-toolchain.cmake
  gcc14              — cmake/x86_64-linux-gcc-14-toolchain.cmake

Clang 20 toolchains have moved to toolchain/clang/ and are now hermetic
(downloaded automatically by Bazel).  See toolchain/clang/BUILD.bazel.

Linker selection mirrors cmake/linking.cmake.
Use --config=<name> in .bazelrc to select a toolchain.
"""

load(":cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# ===================================================================
# Filegroups (Bazel requires these for cc_toolchain)
# ===================================================================

filegroup(
    name = "empty",
    srcs = [],
)

# ===================================================================
# GCC 12
# ===================================================================

cc_toolchain_config(
    name = "gcc12_config",
    compiler = "gcc",
    compiler_version = "12",
    stdlib = "libstdc++",
    cc_path = "/usr/bin/gcc-12",
    cxx_path = "/usr/bin/g++-12",
    linker_path = "/usr/bin/ld",
    cxx_builtin_include_directories = [
        "/usr/include/c++/12",
        "/usr/include/x86_64-linux-gnu/c++/12",
        "/usr/lib/gcc/x86_64-linux-gnu/12/include",
        "/usr/include",
        "/usr/lib/linux/uapi/x86",
    ],
)

cc_toolchain(
    name = "gcc12_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":gcc12_config",
)

toolchain(
    name = "gcc12",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":gcc12_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

# ===================================================================
# GCC 14
# ===================================================================

cc_toolchain_config(
    name = "gcc14_config",
    compiler = "gcc",
    compiler_version = "14",
    stdlib = "libstdc++",
    cc_path = "/usr/bin/gcc-14",
    cxx_path = "/usr/bin/g++-14",
    linker_path = "/usr/bin/ld",
    cxx_builtin_include_directories = [
        "/usr/include/c++/14",
        "/usr/include/x86_64-linux-gnu/c++/14",
        "/usr/lib/gcc/x86_64-linux-gnu/14/include",
        "/usr/include",
        "/usr/lib/linux/uapi/x86",
    ],
)

cc_toolchain(
    name = "gcc14_toolchain",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    toolchain_config = ":gcc14_config",
)

toolchain(
    name = "gcc14",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":gcc14_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
