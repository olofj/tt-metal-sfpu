    linker_path = "/usr/bin/ld.mold",
    cxx_builtin_include_directories = [
        "/usr/include/c++/14",
        "/usr/include/x86_64-linux-gnu/c++/14",
        "/usr/lib/llvm-20/lib/clang/20/include",
