"""SFPI RISC-V cross-compilation toolchains for Tenstorrent device firmware.

Toolchain variants (selected via --config= in .bazelrc):
  sfpi-wormhole   — Wormhole chips (-mcpu=tt-wh)
  sfpi-blackhole  — Blackhole chips (-mcpu=tt-bh)
  sfpi-quasar32   — Quasar 32-bit cores (-mcpu=tt-qsr32)
  sfpi-quasar64   — Quasar 64-bit cores (-mcpu=tt-qsr64)

The cc_toolchain and cc_toolchain_config targets live inside the @sfpi
external repository (generated by the repository rule in repo.bzl).
This package defines the toolchain() wrappers with platform constraints
and the platform definitions themselves.
"""

package(default_visibility = ["//visibility:public"])

# ===================================================================
# Platform constraint for TT RISC-V architecture variants
# ===================================================================

constraint_setting(name = "tt_riscv_arch")

constraint_value(
    name = "tt_wormhole",
    constraint_setting = ":tt_riscv_arch",
)

constraint_value(
    name = "tt_blackhole",
    constraint_setting = ":tt_riscv_arch",
)

constraint_value(
    name = "tt_quasar32",
    constraint_setting = ":tt_riscv_arch",
)

constraint_value(
    name = "tt_quasar64",
    constraint_setting = ":tt_riscv_arch",
)

# ===================================================================
# Target platforms for cross-compilation
# ===================================================================

platform(
    name = "riscv_wormhole",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_wormhole",
    ],
)

platform(
    name = "riscv_blackhole",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_blackhole",
    ],
)

platform(
    name = "riscv_quasar32",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_quasar32",
    ],
)

platform(
    name = "riscv_quasar64",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_quasar64",
    ],
)

# ===================================================================
# Toolchain wrappers — connect cc_toolchains in @sfpi to platforms
# ===================================================================

toolchain(
    name = "sfpi_wormhole",
    exec_compatible_with = [
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_wormhole",
    ],
    toolchain = "@sfpi//:sfpi_wormhole_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

toolchain(
    name = "sfpi_blackhole",
    exec_compatible_with = [
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_blackhole",
    ],
    toolchain = "@sfpi//:sfpi_blackhole_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

toolchain(
    name = "sfpi_quasar32",
    exec_compatible_with = [
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_quasar32",
    ],
    toolchain = "@sfpi//:sfpi_quasar32_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

toolchain(
    name = "sfpi_quasar64",
    exec_compatible_with = [
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
        ":tt_quasar64",
    ],
    toolchain = "@sfpi//:sfpi_quasar64_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
