"""Hermetic Clang 20 host toolchains (downloaded from LLVM releases).

Toolchain variants:
  clang20_libcpp     — Clang 20 + bundled libc++, using LLD
  clang20_libstdcpp  — Clang 20 + system libstdc++, using LLD

The cc_toolchain and cc_toolchain_config targets live inside the
@llvm_clang external repository (generated by the repository rule in
repo.bzl).  This package defines the toolchain() wrappers with
platform constraints.
"""

package(default_visibility = ["//visibility:public"])

# ===================================================================
# Clang 20 + libc++ (hermetic)
# ===================================================================

toolchain(
    name = "clang20_libcpp",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = "@llvm_clang//:clang20_libcpp_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

# ===================================================================
# Clang 20 + libstdc++ (hermetic)
# ===================================================================

toolchain(
    name = "clang20_libstdcpp",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = "@llvm_clang//:clang20_libstdcpp_cc_toolchain",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
