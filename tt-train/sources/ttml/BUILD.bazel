# ttml — TT Machine Learning Library (static C++ library).
#
# Mirrors the CMake target: ttml (STATIC library)
# Provides autograd, operations, models, optimizers, serialization,
# and custom metal ops for training on Tenstorrent hardware.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:cc_fbs.bzl", "cc_fbs_library")

package(default_visibility = ["//tt-train:__subpackages__"])

# ===========================================================================
# FlatBuffers schema for model metadata serialization.
# Generates ttml_metadata_generated.h from the .fbs schema.
#
# Source files include the generated header as bare "ttml_metadata_generated.h"
# so the cc_fbs_library's includes must point to the serialization/ subdir.
# We use cc_fbs_library (which generates into serialization/) and override
# the include path with a wrapper cc_library.
# ===========================================================================

cc_fbs_library(
    name = "ttml_metadata_fbs_gen",
    srcs = ["serialization/ttml_metadata.fbs"],
)

cc_library(
    name = "ttml_metadata_fbs",
    hdrs = [":ttml_metadata_fbs_gen_gen"],
    includes = ["serialization"],
    deps = ["@flatbuffers//:flatbuffers"],
)

# ===========================================================================
# Metal device kernels — runtime data for JIT compilation.
# These files are NOT compiled by the host compiler; they are loaded at
# runtime by TT-Metalium's JIT system. Paths are referenced as string
# constants in program factory source files.
# ===========================================================================

filegroup(
    name = "metal_kernels",
    srcs = glob(["metal/**/kernels/**"]),
    visibility = ["//visibility:public"],
)

# ===========================================================================
# ttml — the core static library.
#
# All host-compiled sources are listed explicitly, matching the CMake
# SOURCES and METAL_OPS_FILES lists in CMakeLists.txt. Metal kernel files
