# --- Top-level CI tarball (uncompressed) ---
# Composes all component sub-tarballs into a single archive.
pkg_tar(
    name = "ci_tarball_tar",
    testonly = True,
    tags = ["manual"],
    deps = [
        ":ci_tarball_examples",
        ":ci_tarball_lib",
        ":ci_tarball_lib_ttnn",
        ":ci_tarball_runtime",
        ":ci_tarball_tests",
        ":ci_tarball_ttnn_ext",
    ],
)

# --- Compressed CI tarball (.tar.zst) ---
# Uses zstd compression matching CI flags (--adapt=min=9 -T0).
# This is the target CI workflows should build.
genrule(
    name = "ci_tarball",
    testonly = True,
    srcs = [":ci_tarball_tar"],
    outs = ["ttm_any.tar.zst"],
    cmd = "$(execpath //bazel:zstd_compress) < $< > $@",
    tags = ["manual"],
    tools = ["//bazel:zstd_compress"],
    visibility = ["//visibility:public"],
)

