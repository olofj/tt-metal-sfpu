"""Debian packages for tt-metalium and tt-nn.

Mirrors the CPack component-based packaging in cmake/packaging.cmake.
Each component group produces a separate .deb file, matching the naming
and file layout of the CMake build.

Component groups (from cmake/packaging.cmake):
  metalium       → tt-metalium        (runtime: libtt_metal.so, UMD, Tracy)
  metalium-dev   → tt-metalium-dev    (SDK: headers, CMake configs, 3rd-party)
  metalium-jit   → tt-metalium-jit    (JIT: SFPI toolchain, kernels)
  metalium-examples → tt-metalium-examples (kernel programming examples)
  metalium-validation → tt-metalium-validation (validation test binaries)
  nn             → tt-nn              (runtime: libttnn.so, _ttnn.so)
  nn-dev         → tt-nn-dev          (SDK: TTNN headers, CMake configs)
  nn-examples    → tt-nn-examples     (TTNN example programs)
  nn-validation  → tt-nn-validation   (TTNN validation test binaries)

Usage:
  bazel build //packaging:all                              # all packages
  bazel build //packaging:tt-metalium --stamp              # single package, stamped
  bazel build //packaging:tt-metalium --config=release     # release build

Debug symbol packages (.ddeb) are gated behind the :enable_debuginfo setting
and excluded by default (matching CPack behavior for non-Release builds).
"""

load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_pkg//pkg:deb.bzl", "pkg_deb")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "pkg_mkdirs")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bazel:stamp_version.bzl", "stamp_version")
load("//packaging:cmake_config.bzl", "cmake_package_config", "cmake_package_version")
load("//packaging:deb.bzl", "tt_deb")

package(default_visibility = ["//visibility:public"])

# ===========================================================================
# Shared library targets for .deb and SDK packaging
#
# These cc_shared_library targets produce the .so files shipped in the
# .deb packages. They live here (not alongside their cc_library sources)
# because cc_library implicitly generates lib<name>.so, which would
# conflict with a same-named target in the same Bazel package.
#
# Dependency chain (dynamic_deps):
#   libtt_stl.so          — independent leaf (owns fmt, spdlog, tt_logger)
#   libumd.so             — depends on libtt_stl.so (shared external deps)
#   libTracyClient.so     — independent leaf (no shared deps)
#   libtt_metal.so        — depends on all three above
#   _ttnncpp.so           — depends on libtt_metal.so
# ===========================================================================

# Mirrors CMake: libtt_stl.so (TT::STL SHARED)
# exports_filter includes external deps shared with other shared libraries
# (UMD also uses fmt, spdlog, tt_logger). By exporting these from tt_stl,
# other shared libraries can reference them via dynamic_deps.
cc_shared_library(
    name = "libtt_stl.so",
    deps = ["//tt_stl"],
    exports_filter = [
        "//tt_stl:__pkg__",
        "@fmt//:__pkg__",
        "@spdlog//:__pkg__",
        "@tt_logger//:__pkg__",
    ],
    shared_lib_name = "libtt_stl.so",
)

# Mirrors CMake: libumd.so (umd::device SHARED)
# UMD shares external deps (fmt, spdlog, tt_logger) with tt_stl; the
# dynamic_dep on libtt_stl.so tells Bazel those are already provided.
# UMD-owned external deps (yaml-cpp, asio, picosha2) are exported so
# libtt_metal.so can use them via dynamic_deps.
cc_shared_library(
    name = "libumd.so",
    deps = ["//tt_metal/third_party/umd/device"],
    dynamic_deps = [":libtt_stl.so"],
    exports_filter = [
        "//tt_metal/third_party/umd/device:__subpackages__",
        "//tt_metal/third_party/umd/src:__subpackages__",
        "@yaml-cpp//:__pkg__",
        "@asio//:__pkg__",
        "@picosha2//:__pkg__",
    ],
    shared_lib_name = "libumd.so",
    user_link_flags = ["-lrt"],
)

# Mirrors CMake: libTracyClient.so (TracyClient SHARED, OUTPUT_NAME tracy)
cc_shared_library(
    name = "libTracyClient.so",
    deps = ["//tt_metal/third_party:tracy_client"],
    exports_filter = [
        "//tt_metal/third_party:__pkg__",
    ],
    shared_lib_name = "libTracyClient.so",
)

# Mirrors CMake: libtt_metal.so (TT::Metalium SHARED)
# External deps are exported so downstream shared libraries
# (_ttnncpp.so) can reference them via dynamic_deps.
cc_shared_library(
    name = "libtt_metal.so",
    deps = ["//tt_metal"],
    dynamic_deps = [
        ":libtt_stl.so",
        ":libumd.so",
        ":libTracyClient.so",
    ],
    exports_filter = [
        "//tt_metal:__subpackages__",
        "//tools/scaleout:__subpackages__",
        "//third_party/system:__pkg__",
        "@enchantum//:__pkg__",
        "@flatbuffers//:__pkg__",
        "@nlohmann_json//:__pkg__",
        "@reflect//:__pkg__",
        "@protobuf//:__subpackages__",
        "@capnproto//:__subpackages__",
        "@taskflow//:__pkg__",
        "@boost.algorithm//:__subpackages__",
        "@boost.container//:__subpackages__",
        "@boost.core//:__subpackages__",
        "@boost.interprocess//:__subpackages__",
        "@boost.smart_ptr//:__subpackages__",
    ],
    shared_lib_name = "libtt_metal.so",
)


# ===========================================================================
# Version stamping
#
# Extracts STABLE_VERSION from bazel/stamp_version.sh and converts it to
# Debian version format. The stamp_version.sh already produces PEP 440
# versions that are close to Debian format; we reuse as-is since the CMake
# version.cmake also derives from git describe.
#
# With --stamp:   real version from git tags (e.g., "0.65.2+1521.a1b2c3d4")
# With --nostamp: fallback "0.0.0.dev0"
# ===========================================================================

stamp_version(
    name = "deb_version",
    key = "STABLE_VERSION",
    fallback = "0.0.0~dev0",
)

# ===========================================================================
# metalium — TT-Metalium runtime library
#
# CMake components: metalium, metalium-runtime, umd-runtime, tracy
# Contents: libtt_metal.so, libtt_stl.so, libumd.so, libTracyClient.so,
#           JIT API headers (libexec/), SoC descriptors, core descriptors
# ===========================================================================

pkg_files(
    name = "metalium_runtime_libs",
    srcs = [
        ":libtt_metal.so",
        ":libtt_stl.so",
        ":libumd.so",
        ":libTracyClient.so",
    ],
    prefix = "usr/lib",
)

# JIT API headers, SoC/core descriptors, and toolchain files shipped with
# the metalium runtime for on-device compilation. Uses pkg_tar to preserve
# the directory structure (files span multiple Bazel packages with shared
# basenames, so pkg_files would have collisions).
pkg_tar(
    name = "metalium_jitapi_tar",
    srcs = [
        "//tt_metal/hw:jit_headers",
        "//tt_metal/fabric:fabric_jit_api",
        "//tt_metal:deb_descriptors",
        "//tt_metal/hw/toolchain:all_linker_scripts",
        "//tt_metal/hw/toolchain:linker_script_sources",
    ],
    package_dir = "usr/libexec/tt-metalium",
    strip_prefix = ".",
)

pkg_tar(
    name = "metalium_data",
    srcs = [
        ":metalium_runtime_libs",
    ],
    # Both metalium_jitapi_tar and metalium_runtime_libs create usr/
    # directory entries; allow the harmless duplicate silently.
    allow_duplicates_from_deps = True,
    deps = [
        ":metalium_jitapi_tar",
    ],
)

tt_deb(
    name = "tt-metalium",
    data_tar = ":metalium_data",
    description = "TT-Metalium runtime library",
    package = "tt-metalium",
    section = "libs",
)

# ===========================================================================
# metalium-dev — TT-Metalium SDK (headers, CMake configs, 3rd-party headers)
#
# CMake components: metalium-dev, fmt-core, enchantum, umd-dev,
#                   spdlog-dev, tt-logger-dev
# Explicit depends: nlohmann-json3-dev (>= 3.10)
# ===========================================================================

# Public API headers and tt_stl headers.
# tt_metal/api headers have short_path tt_metal/api/tt-metalium/... — strip
# "tt_metal/api" to get usr/include/tt-metalium/...
# tt_stl headers have short_path tt_stl/tt_stl/... — strip "tt_stl" to get
# usr/include/tt_stl/...
pkg_tar(
    name = "metalium_dev_api_headers_tar",
    srcs = [
        "//tt_metal/api:deb_headers",
    ],
    package_dir = "usr/include",
    strip_prefix = "tt_metal/api",
)

pkg_tar(
    name = "metalium_dev_stl_headers_tar",
    srcs = [
        "//tt_stl:deb_headers",
    ],
    package_dir = "usr/include",
    strip_prefix = "tt_stl",
)

# 3rd-party headers exported in the public API.
# Mirrors CMake: install(TARGETS reflect enchantum TracyClient tt-logger
#   FILE_SET api DESTINATION include/metalium-thirdparty)
# Each library uses a separate pkg_tar because the source trees have
# different layouts requiring distinct strip_prefix values.
# NOTE: strip_prefix must be absolute (leading "/") for external repos;
# without it, rules_pkg prepends the consuming package path ("packaging/").

pkg_tar(
    name = "metalium_dev_reflect_tar",
    srcs = ["@reflect//:deb_headers"],
    package_dir = "usr/include/metalium-thirdparty",
    strip_prefix = "/external/+non_bcr_deps+reflect",
)

pkg_tar(
    name = "metalium_dev_enchantum_tar",
    srcs = ["@enchantum//:deb_headers"],
    package_dir = "usr/include/metalium-thirdparty",
    strip_prefix = "/external/+non_bcr_deps+enchantum/enchantum/include",
)

pkg_tar(
    name = "metalium_dev_tracy_tar",
    srcs = ["//tt_metal/third_party:deb_tracy_headers"],
    package_dir = "usr/include/metalium-thirdparty",
    strip_prefix = "/tt_metal/third_party/tracy/public",
)

pkg_tar(
    name = "metalium_dev_tt_logger_tar",
    srcs = ["@tt_logger//:deb_headers"],
    package_dir = "usr/include/metalium-thirdparty",
    strip_prefix = "/external/+non_bcr_deps+tt_logger/include",
)

pkg_tar(
    name = "metalium_dev_thirdparty_headers_tar",
    deps = [
        ":metalium_dev_reflect_tar",
        ":metalium_dev_enchantum_tar",
        ":metalium_dev_tracy_tar",
        ":metalium_dev_tt_logger_tar",
    ],
)

# CMake package config files for find_package(TT-Metalium).
# Generated from the same .in templates as CMake (cmake/packaging.d/).
cmake_package_config(
    name = "metalium_cmake_config",
    output_name = "tt-metalium-config.cmake",
    project_name = "Metalium",
    template = "//cmake/packaging.d:tt-metalium-config.cmake.in",
)

cmake_package_version(
    name = "metalium_cmake_config_version",
    output_name = "tt-metalium-config-version.cmake",
    version = ":deb_version",
)

# CMake imported targets file for TT::Metalium, TT::tt_stl, etc.
# The config template includes this via include("${CMAKE_CURRENT_LIST_DIR}/Metalium.cmake").
# This is the Bazel equivalent of CMake's install(EXPORT Metalium ...) output.
genrule(
    name = "metalium_cmake_targets",
    srcs = ["//cmake/packaging.d:Metalium.cmake.in"],
    outs = ["Metalium.cmake"],
    cmd = "cp $< $@",
)

pkg_files(
    name = "metalium_dev_cmake",
    srcs = [
        ":metalium_cmake_config",
        ":metalium_cmake_config_version",
        ":metalium_cmake_targets",
    ],
    prefix = "usr/lib/cmake/tt-metalium",
)

# Proto schema files for external use (from tt_metal/fabric/protobuf/).
pkg_tar(
    name = "metalium_dev_protos_tar",
    srcs = [
        "//tt_metal/fabric/protobuf:proto_schemas",
    ],
    package_dir = "usr/share/tt-metalium/proto",
    strip_prefix = "tt_metal/fabric/protobuf",
)

pkg_tar(
    name = "metalium_dev_data",
    srcs = [
        ":metalium_dev_cmake",
    ],
    deps = [
        ":metalium_dev_api_headers_tar",
        ":metalium_dev_protos_tar",
        ":metalium_dev_stl_headers_tar",
        ":metalium_dev_thirdparty_headers_tar",
    ],
)

tt_deb(
    name = "tt-metalium-dev",
    data_tar = ":metalium_dev_data",
    depends = [
        "tt-metalium (= @VERSION@)",
        "nlohmann-json3-dev (>= 3.10)",
    ],
    description = "TT-Metalium SDK",
    package = "tt-metalium-dev",
    section = "devel",
)

# ===========================================================================
# metalium-jit — JIT runtime (SFPI toolchain, kernel sources)
#
# CMake components: metalium-jit, jit-build
# Contains the SFPI RISC-V cross-compiler and kernel source files needed
# for runtime compilation on device.
# ===========================================================================

# The SFPI toolchain is downloaded via the sfpi_toolchain_repo repository
# rule (toolchain/sfpi/repo.bzl), mirroring CMake's FetchContent approach
# (tt_metal/hw/CMakeLists.txt). The @sfpi repo provides the full compiler
# tree (compiler/bin/riscv-tt-elf-g++, etc.) for JIT compilation on device.
# strip_prefix removes the external repo path prefix (external/+sfpi_ext+sfpi)
# so only the internal directory structure (compiler/bin/, include/) remains.
pkg_tar(
    name = "metalium_jit_data",
    srcs = ["@sfpi//:all_files"],
    package_dir = "usr/libexec/tt-metalium/runtime/sfpi",
    strip_prefix = "/external/+sfpi_ext+sfpi",
)

tt_deb(
    name = "tt-metalium-jit",
    data_tar = ":metalium_jit_data",
    description = "TT-Metalium JIT runtime library",
    package = "tt-metalium-jit",
    section = "libs",
)

