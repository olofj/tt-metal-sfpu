# ===========================================================================
# CI tarball — compiled artifact bundle for hardware test jobs
#
# Replaces the ad-hoc tar command in .github/workflows/build-artifact.yaml
# (lines 535-542) that creates ttm_any.tar.zst. This tarball is the primary
# mechanism for passing build outputs between CI jobs: the build job produces
# it, and every downstream test job extracts it via setup-job/action.yml.
#
# Tarball layout (matches CMake build):
#   ttnn/ttnn/_ttnn.so          — nanobind Python extension
#   build/lib/                  — shared libraries (libtt_metal.so, etc.)
#   build/programming_examples/ — compiled example binaries
#   build/test/                 — compiled gtest binaries
#   build/tools/                — tool executables (future)
#   runtime/                    — device firmware and runtime files
#
# Usage:
#   bazel build //packaging:ci_tarball --config=ci
#   bazel build //packaging:ci_tarball_tar           # uncompressed .tar
#
# NOTE: The CMake CI workflows reference monolithic test binaries like
# build/test/tt_metal/unit_tests_api. The Bazel build produces individual
# test binaries instead (one per cc_test target). CI workflows will need
# updating to use the individual binaries — tracked by tt-metal-90z.
#
# All ci_tarball_* targets are tagged "manual" to exclude them from wildcard
# builds (bazel build ...). This prevents action conflicts: pkg_tar targets
# pull test binaries in a different configuration than the direct build,
# causing "conflicting actions" errors. CI builds these explicitly.
# ===========================================================================

# --- Component sub-tarballs ---
# Each component maps to a top-level directory in the CI tarball.

# Shared libraries → build/lib/
# Mirrors: libtt_metal.so, libumd.so, libtt_stl.so, libTracyClient.so,
#          _ttnncpp.so (TTNN C++ shared library)
pkg_tar(
    name = "ci_tarball_lib",
    srcs = [
        ":libTracyClient.so",
        ":libtt_metal.so",
        ":libtt_stl.so",
        ":libumd.so",
    ],
    package_dir = "build/lib",
    tags = ["manual"],
)

# _ttnncpp.so ships alongside the other libs in build/lib/.
pkg_tar(
    name = "ci_tarball_lib_ttnn",
    srcs = ["//ttnn:ttnncpp_shared"],
    package_dir = "build/lib",
    tags = ["manual"],
)

# Nanobind Python extension → ttnn/ttnn/
# CI expects ttnn/ttnn/*.so (the _ttnn.so nanobind module).
pkg_tar(
    name = "ci_tarball_ttnn_ext",
    srcs = ["//ttnn:_ttnn.so"],
    package_dir = "ttnn/ttnn",
    tags = ["manual"],
)

# Programming examples → build/programming_examples/
# Compiled example binaries (metal_example_add_2_integers_in_compute, etc.)
pkg_tar(
    name = "ci_tarball_examples",
    srcs = ["//tt_metal/programming_examples:programming_examples"],
    package_dir = "build/programming_examples",
    tags = ["manual"],
)

# Runtime firmware and toolchain → runtime/
# Device firmware .o files and linker scripts (runtime/hw/**).
pkg_tar(
    name = "ci_tarball_runtime",
    srcs = ["//:runtime_hw_files"],
    strip_prefix = ".",
