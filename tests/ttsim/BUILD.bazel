# TTSim test targets — CPU-only wrappers for hardware tests.
#
# These targets run tt_metal C++ tests under the TTSim software simulator,
# requiring no physical Tenstorrent hardware. Each test gets a Wormhole B0
# (_wh) and Blackhole (_bh) variant that run in parallel.
#
# Because these targets have no requires_* hardware tags, they are included
# in the default `bazel test ...` invocation on any machine.
#
# Usage:
#   bazel test //tests/ttsim/...           # All ttsim tests (WH + BH)
#   bazel test //tests/ttsim:ttsim_all_wh  # All Wormhole tests
#   bazel test //tests/ttsim:ttsim_all_bh  # All Blackhole tests

load("//bazel:ttsim.bzl", "ttsim_test_suite")
load("//bazel:ttsim_runtime.bzl", "firmware_obj", "ttsim_runtime")

package(default_visibility = ["//visibility:public"])

# ===================================================================
# Runtime trees — cross-compiled firmware objects + linker scripts
#
# Each firmware source is compiled to .o using the SFPI cross-compiler
# via genrule (no platform transition needed). The ttsim_runtime rule
# assembles everything into the directory layout the JIT build expects.
# ===================================================================

# Common include paths for toolchain support objects (tmu-crt0, substitutes)
_TOOLCHAIN_COPTS = [
    "-Itt_metal/hw/inc",
    "-Itt_metal/hw/firmware/src/tt-1xx",
]

# --- Wormhole firmware objects ----------------------------------------

_WH_HDRS = [
    "//tt_metal/hw/inc/internal/tt-1xx/wormhole:all_headers",
    "//tt_metal/hw:jit_internal_common_headers",
]

firmware_obj(
    name = "wh_tmu_crt0",
    src = "//tt_metal/hw/toolchain:tmu-crt0.S",
    obj_name = "tmu-crt0.o",
    mcpu = "tt-wh",
    copts = _TOOLCHAIN_COPTS,
)

firmware_obj(
    name = "wh_substitutes",
    src = "//tt_metal/hw/toolchain:substitutes.cpp",
    obj_name = "substitutes.o",
    mcpu = "tt-wh",
    copts = _TOOLCHAIN_COPTS,
)

firmware_obj(
    name = "wh_iram_trampoline",
    src = "//tt_metal/hw/toolchain:wh-iram-trampoline.S",
    obj_name = "wh-iram-trampoline.o",
    mcpu = "tt-wh",
    hdrs = _WH_HDRS,
    copts = _TOOLCHAIN_COPTS + [
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole",
    ],
)

firmware_obj(
    name = "wh_iram_start",
    src = "//tt_metal/hw/toolchain:wh-iram-start.S",
    obj_name = "wh-iram-start.o",
    mcpu = "tt-wh",
    hdrs = _WH_HDRS,
    copts = _TOOLCHAIN_COPTS + [
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole",
    ],
)

firmware_obj(
    name = "wh_noc",
    src = "//tt_metal/hw/firmware/src/tt-1xx:wormhole/noc.c",
    obj_name = "noc.o",
    mcpu = "tt-wh",
    hdrs = _WH_HDRS,
    copts = [
        "-DARCH_WORMHOLE",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/wormhole_b0_defines",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/noc",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
)

firmware_obj(
    name = "wh_tdma_xmov",
    src = "//tt_metal/hw/firmware/src/tt-1xx:tdma_xmov.c",
    obj_name = "tdma_xmov.o",
    mcpu = "tt-wh",
    hdrs = _WH_HDRS,
    copts = [
        "-DARCH_WORMHOLE",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/wormhole_b0_defines",
        "-Itt_metal/hw/inc/internal/tt-1xx/wormhole/noc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
)

ttsim_runtime(
    name = "runtime_wh",
    arch_dir = "wormhole",
    firmware_objs = [
        ":wh_tmu_crt0",
        ":wh_substitutes",
        ":wh_iram_trampoline",
        ":wh_iram_start",
        ":wh_noc",
        ":wh_tdma_xmov",
    ],
    linker_scripts = ["//tt_metal/hw/toolchain:wormhole_linker_scripts"],
)

# --- Blackhole firmware objects ----------------------------------------

_BH_HDRS = [
    "//tt_metal/hw/inc/internal/tt-1xx/blackhole:all_headers",
    "//tt_metal/hw:jit_internal_common_headers",
]

firmware_obj(
    name = "bh_tmu_crt0",
    src = "//tt_metal/hw/toolchain:tmu-crt0.S",
    obj_name = "tmu-crt0.o",
    mcpu = "tt-bh",
    copts = _TOOLCHAIN_COPTS,
)

firmware_obj(
    name = "bh_substitutes",
    src = "//tt_metal/hw/toolchain:substitutes.cpp",
    obj_name = "substitutes.o",
    mcpu = "tt-bh",
    copts = _TOOLCHAIN_COPTS,
)

firmware_obj(
    name = "bh_noc",
    src = "//tt_metal/hw/firmware/src/tt-1xx:blackhole/noc.c",
    obj_name = "noc.o",
    mcpu = "tt-bh",
    hdrs = _BH_HDRS,
    copts = [
        "-DARCH_BLACKHOLE",
        "-Itt_metal/hw/inc/internal/tt-1xx/blackhole",
        "-Itt_metal/hw/inc/internal/tt-1xx/blackhole/noc",
        "-Itt_metal/hw/inc",
        "-Itt_metal/hw/firmware/src/tt-1xx",
    ],
)

ttsim_runtime(
    name = "runtime_bh",
    arch_dir = "blackhole",
    firmware_objs = [
        ":bh_tmu_crt0",
        ":bh_substitutes",
        ":bh_noc",
    ],
    linker_scripts = ["//tt_metal/hw/toolchain:blackhole_linker_scripts"],
)

# ===================================================================
# Test targets
#
# Each ttsim_test_suite creates _wh and _bh variants that run in
# parallel. Omitting gtest_filter runs all cases in the binary.
# All targets validated to pass on CPU-only machines under TTSim.
# ===================================================================

_TT_METAL = "//tests/tt_metal/tt_metal"

# ---------------------------------------------------------------------------
# API tests
# ---------------------------------------------------------------------------

ttsim_test_suite(
    name = "api_noc",
    test = _TT_METAL + ":api_test_noc",
    # NOC.TensixVerifyNocIdentityTranslationTable crashes on WH (unimplemented
    # register NOC_X_ID_TRANSLATE_TABLE_0). Passes on BH but excluded for
    # consistency. Remaining 11 cases all pass on both architectures.
    gtest_filter = "*:-NOC.TensixVerifyNocIdentityTranslationTable",
)

ttsim_test_suite(
    name = "api_dram",
    test = _TT_METAL + ":api_test_dram",
)

# ---------------------------------------------------------------------------
# Debug tools — dprint tests
# ---------------------------------------------------------------------------

ttsim_test_suite(
    name = "debug_dprint_eth",
    test = _TT_METAL + ":debug_tools_dprint_test_eth_cores",
)

ttsim_test_suite(
    name = "debug_dprint_before_finish",
    test = _TT_METAL + ":debug_tools_dprint_test_print_before_finish",
)

ttsim_test_suite(
    name = "debug_dprint_buffering",
    test = _TT_METAL + ":debug_tools_dprint_test_print_buffering",
)

ttsim_test_suite(
    name = "debug_dprint_prepend",
    test = _TT_METAL + ":debug_tools_dprint_test_print_prepend_device_core_risc",
)

# ---------------------------------------------------------------------------
# Debug tools — watcher tests
# ---------------------------------------------------------------------------

ttsim_test_suite(
    name = "debug_watcher_ringbuf",
    test = _TT_METAL + ":debug_tools_watcher_test_ringbuf",
)

ttsim_test_suite(
    name = "debug_watcher_stack_usage",
    test = _TT_METAL + ":debug_tools_watcher_test_stack_usage",
)

ttsim_test_suite(
    name = "debug_watcher_assert",
    test = _TT_METAL + ":debug_tools_watcher_test_assert",
)

ttsim_test_suite(
    name = "debug_watcher_sanitize",
    test = _TT_METAL + ":debug_tools_watcher_test_sanitize",
)

# ---------------------------------------------------------------------------
# Dispatch tests
# ---------------------------------------------------------------------------

ttsim_test_suite(
    name = "dispatch",
    test = _TT_METAL + ":dispatch_dispatch_program_test_dispatch",
)

# ---------------------------------------------------------------------------
# Ethernet tests
# ---------------------------------------------------------------------------

ttsim_test_suite(
    name = "eth_basic",
    test = _TT_METAL + ":eth_test_basic_eth",
)

# ---------------------------------------------------------------------------
# Device simulator tests
# ---------------------------------------------------------------------------

ttsim_test_suite(
    name = "device_simulator",
    test = _TT_METAL + ":device_test_simulator_device",
)

# ---------------------------------------------------------------------------
# Aggregate suites
# ---------------------------------------------------------------------------

_ALL_SUITES = [
    "api_noc",
    "api_dram",
    "debug_dprint_eth",
    "debug_dprint_before_finish",
    "debug_dprint_buffering",
    "debug_dprint_prepend",
    "debug_watcher_ringbuf",
    "debug_watcher_stack_usage",
    "debug_watcher_assert",
    "debug_watcher_sanitize",
    "dispatch",
    "eth_basic",
    "device_simulator",
]

test_suite(
    name = "ttsim_all",
    tests = [":{}_wh".format(s) for s in _ALL_SUITES] +
            [":{}_bh".format(s) for s in _ALL_SUITES],
)

test_suite(
    name = "ttsim_all_wh",
    tests = [":{}_wh".format(s) for s in _ALL_SUITES],
)

test_suite(
    name = "ttsim_all_bh",
    tests = [":{}_bh".format(s) for s in _ALL_SUITES],
)
