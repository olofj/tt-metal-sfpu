# tt_fabric tests — gtest-based test targets for fabric routing, data movement,
# physical discovery, system health, and benchmarks.
#
# Mirrors the CMake test executables from tests/tt_metal/tt_fabric/CMakeLists.txt.
# Each test suite gets its own cc_test target for fine-grained affected-target analysis.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = [
    "//packaging:__pkg__",
    "//tests:__subpackages__",
    "//tt_metal/test:__pkg__",
])

# --------------------------------------------------------------------------
# Test data files (mesh descriptors, cluster descriptors, golden files)
# --------------------------------------------------------------------------

filegroup(
    name = "test_data",
    srcs = glob([
        "custom_mesh_descriptors/**",
        "custom_mock_cluster_descriptors/**",
        "custom_mock_PSDs/**",
        "golden_mapping_files/**",
    ]),
)

# Kernel source files used at runtime via JIT compilation.
filegroup(
    name = "test_kernels",
    srcs = glob([
        "fabric_data_movement/kernels/**",
        "feature_bringup/kernels/**",
        "benchmark/collectives/unicast/kernels/**",
        "fabric_data_movement/addrgen_write/kernels/**",
    ]),
)

# --------------------------------------------------------------------------
# Shared test utilities (common/)
# --------------------------------------------------------------------------

cc_library(
    name = "fabric_test_common",
    testonly = True,
    srcs = [
        "common/fabric_command_interface.cpp",
        "common/fabric_worker_kernel_helpers.cpp",
        "common/utils.cpp",
    ],
    hdrs = glob(["common/*.hpp"]),
    # -isystem . : repo-root-relative angled includes in headers
    #   (e.g. <tt_metal/fabric/ccl/ccl_common.hpp> in test_fabric_edm_common.hpp)
    copts = ["-isystem", "."],
    # "common" allows bare #include "fabric_fixture.hpp" (matches CMake's
    # target_include_directories(...  ${CMAKE_CURRENT_SOURCE_DIR}/common)).
    includes = ["common"],
    deps = [
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "@yaml-cpp",
    ],
)

# --------------------------------------------------------------------------
# Benchmark / perf helpers library
# --------------------------------------------------------------------------

cc_library(
    name = "bench_perf_helpers",
    testonly = True,
    srcs = [
        "benchmark/collectives/common/perf_helpers.cpp",
        "benchmark/collectives/unicast/run_unicast_once.cpp",
    ],
    hdrs = ["benchmark/collectives/common/perf_helpers.hpp"],
    copts = ["-Wno-c++11-narrowing"],
    deps = [
        ":fabric_test_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "//tests/tt_metal/tt_metal:test_fixtures",
    ],
)

# --------------------------------------------------------------------------
# Fabric router unit tests (pure-software, mock cluster descriptors)
#
# CMake builds these as a single monolithic "fabric_unit_tests" executable.
# In Bazel, each test file gets its own cc_test for fine-grained analysis.
# --------------------------------------------------------------------------

[cc_test(
    name = "fabric_router_" + src.replace(".cpp", ""),
    srcs = ["fabric_router/" + src],
    data = [
        ":test_data",
        ":test_kernels",
    ],
    deps = [
        ":fabric_test_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "@yaml-cpp",
    ],
    tags = ["unit", "tt_fabric", "fabric_router", "requires_wormhole_b0", "requires_blackhole"],
) for src in [
    "test_routing_tables.cpp",
    "test_mesh_graph_descriptor.cpp",
    "test_topology_mapper.cpp",
    "test_topology_mapper_utils.cpp",
    "test_topology_solver.cpp",
    "test_custom_routing_tables.cpp",
    "test_multi_host.cpp",
    "test_connection_registry.cpp",
    "test_router_channel_mapping.cpp",
    "test_router_connections.cpp",
    "test_router_connection_mapping.cpp",
    "test_router_archetypes.cpp",
    "test_builder_connection_mapping.cpp",
    "test_connection_mapping_logic.cpp",
    "test_fabric_builder_local_connections.cpp",
    "test_fabric_topology_helpers.cpp",
    # NOTE: test_control_plane_logical_to_physical.cpp excluded — references
    # non-existent function build_mesh_adjacency_map (broken source, not a BUILD issue).
]]

# Router integration and device detection tests — these initialize real hardware
# and are placed in a separate group for CI scheduling.
[cc_test(
    name = "fabric_router_" + src.replace(".cpp", ""),
    srcs = ["fabric_router/" + src],
    data = [
        ":test_data",
        ":test_kernels",
    ],
    deps = [
        ":fabric_test_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "@yaml-cpp",
    ],
    size = "large",
    tags = ["integration", "tt_fabric", "fabric_router", "requires_wormhole_b0", "requires_blackhole"],
) for src in [
    "test_z_router_integration.cpp",
    "test_z_router_device_detection.cpp",
]]

# --------------------------------------------------------------------------
# Fabric data movement tests (requires hardware)
#
# CMake includes these in the monolithic "fabric_unit_tests" executable.
# --------------------------------------------------------------------------

# In CMake these are compiled into the monolithic "fabric_unit_tests" executable;
# the test sources cross-reference helper functions across files (e.g.
# test_basic_fabric_apis.cpp calls RunTestUnicastRaw from test_basic_1d_fabric.cpp),
# so they must be linked together in Bazel as well.
cc_test(
    name = "fabric_data_movement_unit_tests",
    srcs = [
        "fabric_data_movement/test_basic_fabric_apis.cpp",
        "fabric_data_movement/test_basic_1d_fabric.cpp",
        "fabric_data_movement/test_basic_fabric_mux.cpp",
        "fabric_data_movement/test_fabric_traffic_generator_kernel.cpp",
    ],
    # -isystem . : repo-root-relative angled includes like <tt_metal/fabric/...>
    # -I.../fabric_data_movement : for "kernels/..." includes
    # -I.../common : test_host_kernel_common.hpp moved here from kernels/
    # -Wno-c++11-narrowing : suppresses narrowing errors in test sources
    copts = [
        "-isystem", ".",
        "-Itests/tt_metal/tt_fabric/fabric_data_movement",
        "-Itests/tt_metal/tt_fabric/common",
        "-Wno-c++11-narrowing",
    ],
    data = [
        ":test_data",
        ":test_kernels",
        "//tests/tt_metal/tt_metal:perf_routing_kernels",
    ],
    deps = [
        ":fabric_test_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
    ],
    tags = ["unit", "tt_fabric", "fabric_data_movement", "requires_multi_device", "requires_wormhole_b0", "requires_blackhole"],
)

# Fabric smoke test (standalone, CMake target: fabric_smoke_tests)
cc_test(
    name = "fabric_data_movement_test_basic_fabric_smoke",
    srcs = ["fabric_data_movement/test_basic_fabric_smoke.cpp"],
    # -isystem . : repo-root-relative includes like "tt_metal/fabric/..."
    copts = ["-isystem", ".", "-Wno-c++11-narrowing"],
    data = [
        ":test_data",
        ":test_kernels",
        "//tests/tt_metal/tt_metal:perf_routing_kernels",
    ],
    deps = [
        ":fabric_test_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
    ],
    tags = ["smoke", "tt_fabric", "fabric_data_movement", "requires_multi_device", "requires_wormhole_b0", "requires_blackhole"],
)

