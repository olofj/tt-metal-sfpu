# tt_metal C++ unit tests — gtest-based test targets.
#
# Mirrors the CMake test executables from tests/tt_metal/tt_metal/CMakeLists.txt
# and all subdirectory CMakeLists.txt files. Each test suite gets its own cc_test
# target for fine-grained affected-target analysis.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = [
    "//tests:__subpackages__",
    "//tt_metal/test:__pkg__",
])

# Shared test fixture and utility headers for tt_metal tests.
# These are used by almost all tt_metal test subdirectories.
cc_library(
    name = "test_fixtures",
    testonly = True,
    hdrs = glob([
        "common/*.hpp",
    ]),
    deps = [
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
    ],
)

# Dispatch test utilities — header-only helpers (generate_arange_vector,
# create_runtime_args, etc.) used by dispatch tests and distributed tests.
cc_library(
    name = "dispatch_test_utils",
    testonly = True,
    hdrs = glob(["dispatch/*_utils.hpp"]) + [
        "dispatch/random_program_fixture.hpp",
    ],
    deps = [
        ":test_fixtures",
        "//tests:test_metal_common_libs",
    ],
)

# Test kernel files used at runtime via JIT compilation.
# Declared as data dependencies for tests that reference them.
filegroup(
    name = "test_kernels",
    srcs = glob(["test_kernels/**"]),
)

# Perf microbenchmark routing kernels — alias to the subpackage filegroup.
# The actual files live in //tests/tt_metal/tt_metal/perf_microbenchmark.
alias(
    name = "perf_routing_kernels",
    actual = "//tests/tt_metal/tt_metal/perf_microbenchmark:routing_kernels",
)

# Test utilities are in //tests/tt_metal:test_utils (parent package).

