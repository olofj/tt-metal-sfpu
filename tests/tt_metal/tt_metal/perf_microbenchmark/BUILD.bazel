# Performance microbenchmark tests — hardware-dependent test targets for
# dispatch, ethernet, routing/fabric, NOC, compute, and memory subsystems.
#
# Mirrors the CMake test executables from
# tests/tt_metal/tt_metal/perf_microbenchmark/CMakeLists.txt and sources.cmake.
# Each test gets its own cc_test target for fine-grained affected-target analysis.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//tests:__subpackages__"])

# --------------------------------------------------------------------------
# Runtime kernel files (JIT-compiled on device, NOT compiled by Bazel).
# Declared as data dependencies for tests that reference them at runtime.
# --------------------------------------------------------------------------

filegroup(
    name = "kernels",
    srcs = glob(
        ["**/kernels/**"],
        exclude = ["routing/kernels/**"],
    ),
)

# Routing kernels — exported separately for use by tt_fabric tests.
filegroup(
    name = "routing_kernels",
    srcs = glob(["routing/kernels/**"]),
    visibility = [
        "//tests/tt_metal/tt_fabric:__pkg__",
        "//tests/tt_metal/tt_metal:__pkg__",
    ],
)

# --------------------------------------------------------------------------
# Shared utility headers used by most perf microbenchmark tests.
# --------------------------------------------------------------------------

cc_library(
    name = "perf_common",
    testonly = True,
    hdrs = glob(["common/*.hpp"]),
    deps = [
        "//tests:test_metal_common_libs",
    ],
)

# --------------------------------------------------------------------------
# Dispatch test header (common.h) — shared infrastructure for dispatch tests.
# --------------------------------------------------------------------------

cc_library(
    name = "dispatch_common",
    testonly = True,
    hdrs = ["dispatch/common.h"],
    deps = [
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
    ],
)

# --------------------------------------------------------------------------
# Routing/fabric test support library — the additional .cpp sources that
# test_tt_fabric.cpp links against (TEST_TT_FABRIC_ADDITIONAL_SOURCES in CMake).
# --------------------------------------------------------------------------

cc_library(
    name = "routing_test_support",
    testonly = True,
    srcs = [
        "routing/tt_fabric_telemetry_manager.cpp",
        "routing/tt_fabric_test_bandwidth_profiler.cpp",
        "routing/tt_fabric_test_bandwidth_results.cpp",
        "routing/tt_fabric_test_code_profiler.cpp",
        "routing/tt_fabric_test_common_types.cpp",
        "routing/tt_fabric_test_config.cpp",
        "routing/tt_fabric_test_context.cpp",
        "routing/tt_fabric_test_device_setup.cpp",
        "routing/tt_fabric_test_eth_readback.cpp",
        "routing/tt_fabric_test_latency_results.cpp",
        "routing/tt_fabric_test_progress_monitor.cpp",
        "routing/tt_fabric_test_results.cpp",
    ],
    hdrs = glob(["routing/*.hpp"]),
    deps = [
        ":perf_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "@yaml-cpp",
    ],
)

# --------------------------------------------------------------------------
# Dispatch benchmarks (require Google Benchmark)
# --------------------------------------------------------------------------

cc_test(
    name = "dispatch_test_pgm_dispatch",
    srcs = ["dispatch/test_pgm_dispatch.cpp"],
    data = [":kernels"],
    deps = [
        ":dispatch_common",
        ":perf_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "//tests/tt_metal/tt_metal:test_fixtures",
        "@google_benchmark//:benchmark",
    ],
    tags = ["perf_microbenchmark", "dispatch", "requires_wormhole_b0", "requires_blackhole"],
)

cc_test(
    name = "dispatch_benchmark_rw_buffer",
    srcs = ["dispatch/benchmark_rw_buffer.cpp"],
    data = [":kernels"],
    deps = [
        ":perf_common",
        "//tests:test_metal_common_libs",
        "//tests/tt_metal:test_utils",
        "@google_benchmark//:benchmark",
    ],
    tags = ["perf_microbenchmark", "dispatch", "requires_wormhole_b0", "requires_blackhole"],
)

