# tt_metal test utilities — shared headers for all tt_metal tests.
#
# Mirrors the header-only utilities in tests/tt_metal/test_utils/.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//tests:__subpackages__"])

cc_library(
    name = "test_utils",
    testonly = True,
    hdrs = glob(
        [
            "test_utils/**/*.hpp",
            "test_utils/**/*.h",
        ],
        allow_empty = True,
    ),
    # Two include roots:
    #   "test_utils" → allows #include "env_vars.hpp" (direct header name)
    #   ".."         → allows #include "tt_metal/test_utils/env_vars.hpp"
    #                  (used by test fixtures in common/)
    includes = [
        "..",
        "test_utils",
    ],
    deps = [
        "//tests:test_metal_common_libs",
    ],
)
