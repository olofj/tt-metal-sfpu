# Non-working Grayskull unit tests (46 test files).
#
# Tests that are known to fail on Grayskull hardware. Tracked here for
# regression testing when fixes are applied.

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "grayskull_non_working_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//tests/tt_eager:sweep_test_utils",
        "//tests/ttnn:test_utils",
        "//ttnn/ttnn:ttnn_py",
        "@pip//loguru",
        "@pip//torch",
    ],
    tags = ["ttnn", "non_working", "grayskull"],
)
