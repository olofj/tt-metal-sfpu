# Nightly backward complex operation tests (11 test files).

load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel:pytest.bzl", "pytest_suite")

py_library(
    name = "backward_complex_utility_funcs",
    testonly = True,
    srcs = ["backward_complex_utility_funcs.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "@pip//torch",
    ],
    visibility = ["//tests:__subpackages__"],
)

pytest_suite(
    name = "backward_complex_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        ":backward_complex_utility_funcs",
        "//tests/tt_eager:sweep_test_utils",
        "//tests/ttnn/nightly/unit_tests/operations/eltwise/backward:utility_funcs",
        "//models/common:utility_functions",
        "//ttnn/ttnn:ttnn_py",
        "@pip//loguru",
        "@pip//torch",
    ],
    markers = ["slow"],
    tags = ["ttnn", "nightly", "eltwise", "backward", "complex", "requires_wormhole_b0"],
)
