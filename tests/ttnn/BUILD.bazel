# TTNN Python test infrastructure.
#
# conftest.py files are NOT normal Python modules — pytest loads them
# automatically based on directory hierarchy. In Bazel, they must be
# included as data dependencies so they appear in the runfiles tree.

load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//tests:__subpackages__"])

# All conftest.py files across the test tree, collected as a single
# filegroup for easy inclusion in py_test data deps. The pytest_test
# macro automatically includes this in every test target's data.
filegroup(
    name = "conftest_files",
    srcs = glob(["**/conftest.py"]) + [
        # Root conftest.py defines device fixtures, arch parametrization, etc.
        "//:conftest.py",
        # conftest.py files outside the TTNN test tree.
        "//tests/end_to_end_tests:conftest.py",
        "//tests/tt_metal/microbenchmarks:conftest.py",
        "//tests/tt_metal/microbenchmarks/ethernet:conftest.py",
        "//tests/tt_metal/tt_metal/data_movement/python:conftest.py",
    ],
    visibility = ["//visibility:public"],
)

# Test utility modules imported by test files.
# e.g., from tests.ttnn.utils_for_testing import assert_with_pcc
py_library(
    name = "test_utils",
    testonly = True,
    srcs = ["utils_for_testing.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//models/common:utility_functions",
        "@pip//numpy",
        "@pip//torch",
        "@pip//loguru",
    ],
    visibility = ["//visibility:public"],
)

# Utility module with shard grid helpers.
# e.g., from tests.ttnn.ttnn_utility_fuction import get_shard_grid_from_num_cores
py_library(
    name = "ttnn_utility_fuction",
    testonly = True,
    srcs = ["ttnn_utility_fuction.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py",
    ],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# CI test suites — filter tests by marker tags
#
# Usage:
#   bazel test //tests/ttnn:post_commit_tests
#   bazel test //tests/ttnn:frequent_tests
#   bazel test //tests/ttnn/... --test_tag_filters=post_commit
# ---------------------------------------------------------------------------

test_suite(
    name = "post_commit_tests",
    tags = ["post_commit", "-slow", "-frequently_hangs"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "frequent_tests",
    tags = ["frequent"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "nightly_tests",
    tags = ["slow"],
    visibility = ["//visibility:public"],
)
