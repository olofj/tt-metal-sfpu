# TTNN Python test infrastructure.
#
# conftest.py files are NOT normal Python modules — pytest loads them
# automatically based on directory hierarchy. In Bazel, they must be
# included as data dependencies so they appear in the runfiles tree.

load("@rules_python//python:py_library.bzl", "py_library")

package(default_visibility = ["//tests:__subpackages__"])

# All conftest.py files across the test tree, collected as a single
# filegroup for easy inclusion in py_test data deps. The pytest_test
# macro automatically includes this in every test target's data.
filegroup(
    name = "conftest_files",
    srcs = glob(["**/conftest.py"]) + [
        # Root conftest.py defines device fixtures, arch parametrization, etc.
        "//:conftest.py",
        # pytest.ini must be in the runfiles tree so pytest doesn't walk up
        # into the execroot, which would discover conftest.py a second time.
        "//:pytest.ini",
        # conftest.py files outside the TTNN test tree.
        "//tests/end_to_end_tests:conftest.py",
        "//tests/tt_metal/microbenchmarks:conftest.py",
        "//tests/tt_metal/microbenchmarks/ethernet:conftest.py",
        "//tests/tt_metal/tt_metal/data_movement/python:conftest.py",
        # Model conftest.py files — fixtures for model tests (device mesh, model
        # configs, sample inputs, etc.).
        "//models:conftest.py",
        "//models/common/tests:conftest.py",
        "//models/demos/deepseek_v3:conftest.py",
        "//models/demos/gpt_oss:conftest.py",
        "//models/demos/gpt_oss/tests:conftest.py",
        "//models/demos/llama3_70b_galaxy:conftest.py",
        "//models/demos/llama3_70b_galaxy/demo:conftest.py",
        "//models/demos/multimodal/gemma3:conftest.py",
        "//models/demos/multimodal/gemma3/demo:conftest.py",
        "//models/demos/qwen25_vl:conftest.py",
        "//models/demos/qwen25_vl/demo:conftest.py",
        "//models/demos/qwen25_vl/tests:conftest.py",
        "//models/demos/qwen3_vl:conftest.py",
        "//models/demos/qwen3_vl/demo:conftest.py",
        "//models/demos/qwen3_vl/tests:conftest.py",
        "//models/demos/vision/generative/stable_diffusion/wormhole/demo/web_demo:conftest.py",
        "//models/experimental/gemma3_4b:conftest.py",
        "//models/experimental/openvla:conftest.py",
        "//models/experimental/smolvla:conftest.py",
        "//models/experimental/speecht5_tts:conftest.py",
        "//models/demos/stable_diffusion_xl_base:conftest.py",
        "//models/experimental/yunet/tests:conftest.py",
        "//models/tt_dit/tests/dataset_eval:conftest.py",
        "//models/tt_transformers:conftest.py",
        "//models/tt_transformers/demo:conftest.py",
        "//models/tt_transformers/tests:conftest.py",
    ],
    visibility = ["//visibility:public"],
)

# Test utility modules imported by test files.
# e.g., from tests.ttnn.utils_for_testing import assert_with_pcc
py_library(
    name = "test_utils",
    testonly = True,
    srcs = ["utils_for_testing.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//models/common:utility_functions",
        "@pip//numpy",
        "@pip//torch",
        "@pip//loguru",
    ],
    visibility = ["//visibility:public"],
)

# Split-module variant: uses ttnn_py_base (core only, no operations).
# Tests add per-op .so files via ttnn_ops parameter.
py_library(
    name = "test_utils_base",
    testonly = True,
    srcs = ["utils_for_testing.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py_base",
        "//models/common:utility_functions_base",
        "@pip//numpy",
        "@pip//torch",
        "@pip//loguru",
    ],
    visibility = ["//visibility:public"],
)

# Utility module with shard grid helpers.
# e.g., from tests.ttnn.ttnn_utility_fuction import get_shard_grid_from_num_cores
py_library(
    name = "ttnn_utility_fuction",
    testonly = True,
    srcs = ["ttnn_utility_fuction.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py",
    ],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# CI test suites — filter tests by marker tags
#
# These suites mirror the CI groupings defined in
# tests/pipeline_reorg/ttnn-tests.yaml. Each test directory's pytest_suite
# is tagged with markers (post_commit, slow, frequent) and CI-tier tags
# (ttsim, merge_gate) so these top-level suites collect the right targets.
#
# Usage:
#   bazel test //tests/ttnn:post_commit_tests    # All post-commit tests
#   bazel test //tests/ttnn:ttsim_tests          # Tests runnable on TTSim
#   bazel test //tests/ttnn:nightly_tests        # Slow/nightly tests
#   bazel test //tests/ttnn/... --test_tag_filters=post_commit
# ---------------------------------------------------------------------------

test_suite(
    name = "post_commit_tests",
    tags = ["post_commit", "-slow", "-frequently_hangs"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "frequent_tests",
    tags = ["frequent"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "nightly_tests",
    tags = ["slow"],
    visibility = ["//visibility:public"],
)

# TTSim tests — runnable on CPU-only systems with the TT simulator.
# These reference split-module suites so each test only loads the .so files
# it actually needs. On a CPU-only machine:
#   bazel test //tests/ttnn:ttsim_tests
# Note: sdpa_tests_split is excluded (no ttsim support).
test_suite(
    name = "ttsim_tests",
    tests = [
        "//tests/ttnn/unit_tests/operations/eltwise:eltwise_tests_split",
        "//tests/ttnn/unit_tests/operations/matmul:matmul_tests_split",
        "//tests/ttnn/unit_tests/operations/conv:conv_tests_split",
        "//tests/ttnn/unit_tests/operations/conv/data_movement:conv_data_movement_tests_split",
        "//tests/ttnn/unit_tests/operations/reduce:reduce_tests_split",
        "//tests/ttnn/unit_tests/operations/pool:pool_tests_split",
        "//tests/ttnn/unit_tests/operations/debug:debug_tests_split",
        "//tests/ttnn/unit_tests/operations/fused:fused_tests_split",
        "//tests/ttnn/unit_tests/operations/transformers:transformers_tests_split",
        "//tests/ttnn/unit_tests/base_functionality:base_functionality_tests_split",
        "//tests/ttnn/unit_tests/tensor:tensor_tests_split",
    ],
    tags = ["-slow", "-frequently_hangs"],
    visibility = ["//visibility:public"],
)
