# TTNN base functionality unit tests.
#
# Each test_*.py file becomes an individual py_test target for maximum
# affected-target granularity. This allows `bazel query rdeps(...)` to
# determine exactly which tests are affected by a given source change.
#
# Usage:
#   bazel test //tests/ttnn/unit_tests/base_functionality/...
#   bazel test //tests/ttnn/unit_tests/base_functionality:all --test_tag_filters=post_commit

load("//bazel:pytest.bzl", "pytest_suite")

exports_files(
    ["test_bh_20_cores_sharding.py"],
    visibility = ["//tests:__subpackages__"],
)

pytest_suite(
    name = "base_functionality_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//models/common:utility_functions",
        "//tests/tests_common:skip_reasons",
        "//models/demos/bert:ttnn_bert",
        "//models/demos/bert:ttnn_optimized_bert",
        "@pip//torch",
        "@pip//torchvision",
        "@pip//numpy",
        "@pip//loguru",
        "@pip//transformers",
        "@pip//networkx",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole", "ttsim", "monolithic"],
)

# Split-module variant: only loads the operation .so files actually needed
# by base functionality tests. A C++ change to an unrelated operation
# (e.g. matmul) does NOT invalidate these test targets.
pytest_suite(
    name = "base_functionality_tests_split",
    srcs = glob(["test_*.py"]),
    test_suffix = "_split",
    deps = [
        "//ttnn/ttnn:ttnn_py_base",
        "//tests/ttnn:test_utils_base",
        "//models/common:utility_functions_base",
        "//tests/tests_common:skip_reasons",
        "//models/demos/bert:ttnn_bert",
        "//models/demos/bert:ttnn_optimized_bert",
        "@pip//torch",
        "@pip//torchvision",
        "@pip//numpy",
        "@pip//loguru",
        "@pip//transformers",
        "@pip//networkx",
    ],
    ttnn_ops = [
        "creation",
        "data_movement",
        "debug",
        "binary",
        "unary",
        "copy",
    ],
    timeout_seconds = 600,
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole"],
)
