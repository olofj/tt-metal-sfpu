# TTNN tensor unit tests (9 test files).
#
# Each test_*.py file becomes an individual py_test target for maximum
# affected-target granularity. This allows `bazel query rdeps(...)` to
# determine exactly which tests are affected by a given source change.
#
# Usage:
#   bazel test //tests/ttnn/unit_tests/tensor/...
#   bazel test //tests/ttnn/unit_tests/tensor:all --test_tag_filters=post_commit

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "tensor_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole", "ttsim", "monolithic"],
)

# Split-module variant: only loads the operation .so files actually needed
# by tensor tests. A C++ change to an unrelated operation (e.g. matmul)
# does NOT invalidate these test targets.
pytest_suite(
    name = "tensor_tests_split",
    srcs = glob(["test_*.py"]),
    test_suffix = "_split",
    deps = [
        "//ttnn/ttnn:ttnn_py_base",
        "//tests/ttnn:test_utils_base",
        "//models/common:utility_functions_base",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    ttnn_ops = [
        "creation",
        "data_movement",
        "debug",
        "copy",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "ttsim"],
)
