# TTNN data movement operation unit tests (33 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "data_movement_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//tests/ttnn/unit_tests/operations:test_utils",
        "//tests/tt_eager:sweep_test_utils",
        "//tests/ttnn/python_api_testing/sweep_tests:op_map",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
        "@pip//transformers",
    ],
    timeout_seconds = 1800,
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole"],
)
