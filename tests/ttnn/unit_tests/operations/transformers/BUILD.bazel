# TTNN transformer operation unit tests (8 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "transformers_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//tests/ttnn/unit_tests/operations:prefetcher_common",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    tags = ["ttnn", "unit", "requires_wormhole_b0"],
)
