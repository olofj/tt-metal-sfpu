# TTNN transformer operation unit tests (8 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "transformers_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//tests/tt_eager:sweep_test_utils",
        "//tests/ttnn/unit_tests/operations:prefetcher_common",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole", "ttsim", "monolithic"],
)

# Split-module variant: only loads the operation .so files actually needed
# by transformer tests. A C++ change to an unrelated operation (e.g. conv)
# does NOT invalidate these test targets.
pytest_suite(
    name = "transformers_tests_split",
    srcs = glob(["test_*.py"]),
    test_suffix = "_split",
    deps = [
        "//ttnn/ttnn:ttnn_py_base",
        "//tests/ttnn:test_utils_base",
        "//tests/ttnn/unit_tests/operations:prefetcher_common_base",
        "//models/common:utility_functions_base",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
        "@pip//pillow",
    ],
    ttnn_ops = [
        "ccl",
        "experimental",
        "transformer",
        "matmul",
        "creation",
        "data_movement",
        "debug",
        "kv_cache",
        "binary",
        "unary",
        "prefetcher",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole"],
)
