# TTNN convolution operation unit tests (7 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "conv_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole", "ttsim", "monolithic"],
)

# Split-module variant: only loads the operation .so files actually needed
# by conv tests. A C++ change to an unrelated operation (e.g. matmul)
# does NOT invalidate these test targets.
pytest_suite(
    name = "conv_tests_split",
    srcs = glob(["test_*.py"]),
    test_suffix = "_split",
    deps = [
        "//ttnn/ttnn:ttnn_py_base",
        "//tests/ttnn:test_utils_base",
        "//models/common:utility_functions_base",
        "//tests/ttnn/nightly/unit_tests/operations/conv:conv_test_utils",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    ttnn_ops = [
        "ccl",
        "conv",
        "experimental",
        "sliding_window",
        "creation",
        "data_movement",
        "debug",
    ],
    markers = ["post_commit"],
    tags = ["ttnn", "unit", "requires_wormhole_b0", "requires_blackhole"],
)
