# Blackhole system engineering smoke tests for CCL (6 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "bh_sys_eng_smoke_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//tests/ttnn/unit_tests/operations:test_utils",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    tags = ["ttnn", "unit", "ccl", "post_commit", "requires_blackhole"],
)
