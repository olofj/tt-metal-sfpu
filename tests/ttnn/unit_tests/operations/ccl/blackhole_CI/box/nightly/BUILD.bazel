# Blackhole box nightly CCL tests (9 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "bh_box_nightly_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//tests/ttnn/unit_tests/operations:test_utils",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    tags = ["ttnn", "unit", "ccl", "slow", "requires_blackhole", "requires_multi_device"],
)
