# TTNN collective communication (CCL) operation unit tests (12 test files).

load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel:pytest.bzl", "pytest_suite")

py_library(
    name = "fusion_subtests",
    testonly = True,
    srcs = [
        "fusion_subtests/concat_fuse_test.py",
        "fusion_subtests/rms_test.py",
    ],
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//models/perf:benchmarking_utils",
        "//tools/tracy",
        "@pip//torch",
    ],
)

py_library(
    name = "perf_utils",
    testonly = True,
    srcs = [
        "perf/async_perf_csv.py",
        "perf/perf_csv.py",
    ],
    deps = [
        "@pip//pandas",
    ],
)

pytest_suite(
    name = "ccl_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//tests/ttnn:test_utils",
        "//tests/ttnn/unit_tests/operations:test_utils",
        "//tests/tt_eager:sweep_test_utils",
        "//tests/ttnn/unit_tests/operations/ccl:fusion_subtests",
        "//tests/ttnn/unit_tests/operations/ccl:perf_utils",
        "//models/common:utility_functions",
        "//models/perf:benchmarking_utils",
        "//tests/tests_common:skip_reasons",
        "//tests/nightly/t3000/ccl:ccl_test_modules",
        "//tools/tracy",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    tags = ["ttnn", "unit", "ccl", "requires_wormhole_b0", "requires_blackhole", "requires_multi_device"],
)
