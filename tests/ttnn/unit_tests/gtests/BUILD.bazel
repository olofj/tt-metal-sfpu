# TTNN C++ unit tests — gtest-based test targets.
#
# Mirrors the CMake test executables from tests/ttnn/unit_tests/gtests/CMakeLists.txt.
# Each test source file gets its own cc_test target for fine-grained affected-target
# analysis (bazel query rdeps).

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = [
    "//packaging:__pkg__",
    "//tests:__subpackages__",
    "//ttnn/test:__pkg__",
])

# Shared test utility library (PCC correlation, dispatch ops).
# Mirrors CMake's test_common_utils STATIC library.
cc_library(
    name = "test_common_utils",
    testonly = True,
    srcs = ["common_test_utils.cpp"],
    hdrs = [
        "common_test_utils.hpp",
        "ttnn_test_fixtures.hpp",
    ] + glob(["ccl/*.hpp"]),
    includes = ["."],
    # CMake adds ${PROJECT_SOURCE_DIR}/tests as include path; mirror that.
    copts = ["-I$(GENDIR)/tests", "-Itests"],
    deps = [
        "//tests:test_common_libs",
        "//tests/tt_metal:test_utils",
        "//ttnn:all_operations",
    ],
)

# --------------------------------------------------------------------------
# Smoke tests (fast validation)
# --------------------------------------------------------------------------

[cc_test(
    name = src.replace(".cpp", ""),
    srcs = [src],
    deps = [
        ":test_common_utils",
        "//tests:test_common_libs",
        "//ttnn:all_operations",
    ],
    tags = ["smoke", "ttnn", "requires_wormhole_b0", "requires_blackhole"],
) for src in [
    "test_reflect.cpp",
    "test_to_and_from_json.cpp",
    "test_sliding_window_infra.cpp",
    "test_async_runtime.cpp",
    "test_conv2d.cpp",
    "test_multi_cq_multi_dev.cpp",
    "test_multiprod_queue.cpp",
]]

# --------------------------------------------------------------------------
# Basic tests
# --------------------------------------------------------------------------

[cc_test(
    name = src.replace(".cpp", ""),
    srcs = [src],
    # -isystem . : repo-root-relative angled includes (e.g. <tt_metal/api/...>)
    copts = ["-isystem", "."],
    deps = [
        ":test_common_utils",
        "//tests:test_common_libs",
        "//tests/tt_metal/tt_fabric:fabric_test_common",
        "//tests/tt_metal/tt_metal:test_fixtures",
        "//ttnn:all_operations",
    ],
    tags = ["basic", "ttnn", "requires_wormhole_b0", "requires_blackhole"],
) for src in [
    "test_add.cpp",
    "test_add_int.cpp",
    "test_broadcast_to.cpp",
    "test_convert_to_hwc_gather.cpp",
    # test_generic_op.cpp excluded: upstream include conflict between reflect library
    # and tt::tt_metal::detail namespace via multi_device_fixture.hpp.
    "test_graph_add.cpp",
    "test_graph_basic.cpp",
    "test_levelized_graph.cpp",
    "test_graph_capture_arguments_morehdot.cpp",
    "test_graph_capture_arguments_transpose.cpp",
    "test_graph_query_op_constraints.cpp",
    "test_graph_query_op_runtime.cpp",
    "test_launch_operation.cpp",
    "test_relational_int.cpp",
    "test_rsub_int.cpp",
    "test_sub_int.cpp",
]]

# --------------------------------------------------------------------------
# CCL tests (require multi-device hardware)
# --------------------------------------------------------------------------

[cc_test(
    name = src.replace("/", "_").replace(".cpp", ""),
    srcs = [src],
    # -isystem . : repo-root-relative includes (e.g. "tests/ttnn/...")
    # -Wno-c++11-narrowing : upstream narrowing in test sources
    copts = ["-isystem", ".", "-Wno-c++11-narrowing"],
    deps = [
        ":test_common_utils",
        "//tests:test_common_libs",
        "//tests/tt_metal:test_utils",
        "//ttnn:all_operations",
    ],
    tags = ["unit", "ttnn", "ccl", "requires_multi_device", "requires_wormhole_b0", "requires_blackhole"],
) for src in [
    "ccl/test_ccl_commands.cpp",
    "ccl/test_ccl_helpers.cpp",
    "ccl/test_ccl_reduce_scatter_host_helpers.cpp",
    "ccl/test_ccl_tensor_slicers.cpp",
    "ccl/test_erisc_data_mover_with_workers.cpp",
    "ccl/test_fabric_erisc_data_mover_loopback_with_workers.cpp",
    "ccl/test_sharded_address_generators.cpp",
    "ccl/test_sharded_address_generators_new.cpp",
]]

