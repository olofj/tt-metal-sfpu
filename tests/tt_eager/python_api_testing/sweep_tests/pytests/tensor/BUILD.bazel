# TT-Eager sweep tests for tensor operations (5 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "tensor_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//tests/tt_eager:sweep_test_utils",
        "//ttnn/ttnn:ttnn_py",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    tags = ["tt_eager", "sweep", "requires_wormhole_b0"],
)
