# TT-Eager unit tests at the root level (2 test files).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "unit_tests",
    srcs = glob(["test_*.py"], allow_empty = True),
    deps = [
        "//tests/tt_eager:sweep_test_utils",
        "//ttnn/ttnn:ttnn_py",
        "//models/common:utility_functions",
        "@pip//torch",
        "@pip//numpy",
        "@pip//loguru",
    ],
    tags = ["tt_eager", "unit", "requires_wormhole_b0"],
)
