# ===========================================================================
# User overrides (not checked in — create .bazelrc.user for local settings)
# ===========================================================================
try-import %workspace%/.bazelrc.user

# ===========================================================================
# Common build flags (always applied)
#
# Host toolchain flags (C++20, arch-specific codegen, warnings) are baked
# into each cc_toolchain_config (toolchain/cc_toolchain_config.bzl and
# toolchain/clang/cc_toolchain_config.bzl).  They MUST NOT appear here as
# unconditional --copt/--cxxopt flags because those apply to ALL platforms,
# including SFPI RISC-V cross-compilation targets.  The RISC-V compiler
# does not understand x86 flags like -march=x86-64-v3.
#
# Flags that only affect the host (exec) platform are safe here.
# ===========================================================================

# Host-only C++ standard — only affects tools built for the host.
# Target C++ standard is set per-toolchain (C++20 for host, C++17 for SFPI).
build --host_cxxopt=-std=c++20
build --action_env=BAZEL_CXXOPTS=-std=c++20

# Disable -Werror for third-party code that we don't control.
# Cap'n Proto triggers -Wconditional-uninitialized and -Wnontrivial-memcall
# with Clang 20. External deps should not block the build on new warnings.
# Both target and exec configs need this (exec builds compiler tools like capnpc).
build --per_file_copt=external/.*@-Wno-error
build --host_per_file_copt=external/.*@-Wno-error

# Suppress narrowing errors in test sources. The tests were written for GCC
# which treats C++11 narrowing as a warning; Clang treats it as an error.
# This is harmless in test code (int→unsigned, size_t→uint32_t, etc.).
build --per_file_copt=tests/.*@-Wno-c++11-narrowing,-Wno-narrowing

# Compressed debug sections are configured in the host toolchain configs
# (toolchain/cc_toolchain_config.bzl and toolchain/clang/cc_toolchain_config.bzl)
# rather than here, to avoid passing -gz to the SFPI RISC-V cross-compiler.

# Version stamping via git tags (replicates setuptools_scm "guess-next-dev").
# Off by default for dev builds (faster, no cache invalidation on git changes).
# CI configs below enable --stamp for packaging/release builds.
build --workspace_status_command=bazel/stamp_version.sh
build --nostamp

# ===========================================================================
# Build type configurations
#
# Usage: bazel build --config=<type> //<target>
#
# Mirrors CMakeLists.txt lines 40-41 and cmake/sanitizers.cmake.
# Default CMake build type is RelWithDebInfo.
# ===========================================================================

# Debug (CMake: CMAKE_CXX_FLAGS_DEBUG)
build:debug --copt=-O0
build:debug --copt=-g3
build:debug --copt=-ggnu-pubnames
build:debug --copt=-DDEBUG
build:debug --copt=-fno-omit-frame-pointer
build:debug --linkopt=-Wl,--gdb-index

# RelWithDebInfo (CMake default: CMAKE_CXX_FLAGS_RELWITHDEBINFO)
build:relwithdebinfo --copt=-O3
build:relwithdebinfo --copt=-g
build:relwithdebinfo --copt=-ggnu-pubnames
build:relwithdebinfo --copt=-DDEBUG
build:relwithdebinfo --copt=-fno-omit-frame-pointer
build:relwithdebinfo --linkopt=-Wl,--gdb-index

# Release (CMake: standard Release flags, no debug symbols/defines)
build:release --copt=-O3
build:release --stamp

# ===========================================================================
# Sanitizer configurations
#
# Mirrors cmake/sanitizers.cmake. Each sanitizer builds on RelWithDebInfo
# flags, so they inherit optimized+debuggable output.
# ===========================================================================

# ASan + LSan + UBSan (cmake/sanitizers.cmake: asan_flags)
build:asan --config=relwithdebinfo
build:asan --copt=-fsanitize=address,leak,undefined
build:asan --linkopt=-fsanitize=address,leak,undefined

# TSan (cmake/sanitizers.cmake: tsan_flags, overrides -O3 with -O1)
build:tsan --config=relwithdebinfo
build:tsan --copt=-O1
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread

# Code coverage (LLVM source-based coverage, no sanitizers)
build:coverage --config=relwithdebinfo
build:coverage --copt=-fprofile-instr-generate
build:coverage --copt=-fcoverage-mapping
build:coverage --linkopt=-fprofile-instr-generate

# ASan + code coverage combined
build:asan-coverage --config=asan
build:asan-coverage --copt=-fprofile-instr-generate
build:asan-coverage --copt=-fcoverage-mapping
build:asan-coverage --linkopt=-fprofile-instr-generate

# ===========================================================================
# Feature flags
#
# Mirrors cmake/project_options.cmake options.
# Use --config=<feature> to opt in/out.
# ===========================================================================

# Tracy profiler (cmake: ENABLE_TRACY, default ON in CMake)
build:tracy --copt=-DTRACY_ENABLE

# Code timers (cmake: ENABLE_CODE_TIMERS, default OFF)
build:code-timers --copt=-DTT_ENABLE_CODE_TIMERS

# Light Metal Trace (cmake: TT_ENABLE_LIGHT_METAL_TRACE, default ON)
build:light-metal-trace --copt=-DTT_ENABLE_LIGHT_METAL_TRACE=1

# Logging (cmake: TT_METAL_ENABLE_LOGGING, default ON for non-Release)
build:logging --copt=-DSPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_TRACE

# Distributed / MPI multi-host support (cmake: ENABLE_DISTRIBUTED, default ON)
# Requires OpenMPI (or ULFM build at /opt/openmpi-v5.0.7-ulfm).
# Without this flag, the single-host fallback is compiled.
build:distributed --define=enable_distributed=true

# Build time trace (Clang only, cmake: ENABLE_BUILD_TIME_TRACE)
build:time-trace --copt=-ftime-trace

# ===========================================================================
# Clang-tidy static analysis
#
# Mirrors CMakePresets.json clang-tidy preset. Uses the hermetic Clang 20
# toolchain's bundled clang-tidy binary via a Bazel aspect.
#
# Usage:
#   bazel build --config=clang-tidy //...        # Lint everything
#   bazel build --config=clang-tidy //<target>   # Lint one target
# ===========================================================================

build:clang-tidy --aspects=//bazel:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=clang_tidy

# ===========================================================================
# LTO configuration
#
# Mirrors cmake/linking.cmake LTO section. Uses thin LTO by default
# since the project primarily targets Clang.
# ===========================================================================

build:lto --copt=-flto=thin
build:lto --linkopt=-flto=thin
build:lto --copt=-ffunction-sections
build:lto --copt=-fdata-sections
build:lto --copt=-ffat-lto-objects
build:lto --linkopt=-ffat-lto-objects
build:lto --copt=-fforce-emit-vtables
build:lto --copt=-Wodr
build:lto --copt=-Wstrict-aliasing
build:lto --linkopt=-fwhole-program-vtables
build:lto --linkopt=-Wl,--thinlto-jobs=all
build:lto --linkopt=-Wl,--gc-sections
build:lto --linkopt=-Wl,--icf=safe

# ===========================================================================
# C++ toolchain configurations
#
# Usage: bazel build --config=<name> //<target>
#
# These mirror the CMake toolchain files in cmake/*.cmake.
# Linker selection (mold > LLD > ld) is baked into each toolchain config.
# ===========================================================================

# Enable custom toolchain resolution (required for registered toolchains)
build --incompatible_enable_cc_toolchain_resolution

# Clang 20 + libc++ (hermetic — downloaded automatically)
build:clang20-libcpp --extra_toolchains=//toolchain/clang:clang20_libcpp

# Clang 20 + libstdc++ (hermetic — downloaded automatically)
build:clang20-libstdcpp --extra_toolchains=//toolchain/clang:clang20_libstdcpp

# GCC 12 (matches cmake/x86_64-linux-gcc-12-toolchain.cmake)
build:gcc12 --extra_toolchains=//toolchain:gcc12

# GCC 14 (matches cmake/x86_64-linux-gcc-14-toolchain.cmake)
build:gcc14 --extra_toolchains=//toolchain:gcc14

# ===========================================================================
# SFPI RISC-V cross-compilation configurations
#
# Usage: bazel build --config=sfpi-wormhole //<target>
#
# These select the SFPI toolchain with architecture-specific -mcpu flags,
# mirroring tt_metal/hw/CMakeLists.txt GPP_FLAGS_{arch}.
# ===========================================================================

# Wormhole (-mcpu=tt-wh, mirrors GPP_FLAGS_wormhole)
build:sfpi-wormhole --extra_toolchains=//toolchain/sfpi:sfpi_wormhole
build:sfpi-wormhole --platforms=//toolchain/sfpi:riscv_wormhole

# Blackhole (-mcpu=tt-bh, mirrors GPP_FLAGS_blackhole)
build:sfpi-blackhole --extra_toolchains=//toolchain/sfpi:sfpi_blackhole
build:sfpi-blackhole --platforms=//toolchain/sfpi:riscv_blackhole

# Quasar 32-bit (-mcpu=tt-qsr32, for TRISC/compute cores)
build:sfpi-quasar32 --extra_toolchains=//toolchain/sfpi:sfpi_quasar32
build:sfpi-quasar32 --platforms=//toolchain/sfpi:riscv_quasar32

# Quasar 64-bit (-mcpu=tt-qsr64, for DM cores)
build:sfpi-quasar64 --extra_toolchains=//toolchain/sfpi:sfpi_quasar64
build:sfpi-quasar64 --platforms=//toolchain/sfpi:riscv_quasar64

# ===========================================================================
# Remote cache (CI)
#
# Usage: bazel build --config=ci //<target>
#
# Connects to a BuildBuddy remote cache for cross-build artifact sharing.
# The API key is NOT stored here — CI must pass it on the command line:
#
#   bazel build --config=ci \
#     --remote_header=x-buildbuddy-api-key="$BUILDBUDDY_API_KEY" \
#     //<target>
#
# For self-hosted alternatives (bazel-remote), override in .bazelrc.user:
#   build --remote_cache=grpc://your-cache-host:9092
# ===========================================================================

build:ci --remote_cache=grpcs://remote.buildbuddy.io
build:ci --remote_upload_local_results=true
build:ci --remote_instance_name=tt-metal
build:ci --remote_timeout=3600
build:ci --stamp

# Read-only variant for untrusted builds (forks, external PRs).
# Prevents cache poisoning while still benefiting from cache hits.
build:ci-readonly --remote_cache=grpcs://remote.buildbuddy.io
build:ci-readonly --remote_upload_local_results=false
build:ci-readonly --remote_instance_name=tt-metal
build:ci-readonly --remote_timeout=3600

# ===========================================================================
# TTSim simulator configuration
#
# TTSim is a software simulator for Tenstorrent ASICs. Run TTSim tests via
# the dedicated test targets in //tests/ttsim:
#
#   bazel test //tests/ttsim/...           # All TTSim tests (WH + BH)
#   bazel test //tests/ttsim:ttsim_all_wh  # Wormhole tests only
#   bazel test //tests/ttsim:ttsim_all_bh  # Blackhole tests only
#
# These targets are CPU-only (no requires_* tags) so they run on any machine
# without hardware — no --config flag needed.
# ===========================================================================
# Test environment variable passthrough
#
# Bazel test sandboxing strips environment variables by default. These
# --test_env flags pass through variables that tt-metal's runtime reads
# via os.getenv() (Python) or RunTimeOptions (C++). Using the NAME-only
# form (no =value) means the variable is only set in the test if it
# exists in the host environment, so local dev builds are unaffected.
#
# CI workflows set these in their `env:` blocks; this config ensures
# they reach the sandboxed test process.
# ===========================================================================

test --local_test_jobs=1
# --- Hardware & architecture ---
test --test_env=ARCH_NAME
test --test_env=TT_GH_CI_INFRA

# --- Dispatch mode ---
test --test_env=TT_METAL_SLOW_DISPATCH_MODE

# --- Multi-chip / fabric ---
test --test_env=TT_METAL_ENABLE_REMOTE_CHIP
test --test_env=TT_METAL_ENABLE_ERISC_IRAM
test --test_env=TT_METAL_CLEAR_L1
test --test_env=TT_METAL_MOCK_CLUSTER_DESC_PATH
test --test_env=TT_MESH_GRAPH_DESC_PATH
test --test_env=TT_METAL_FABRIC_BW_TELEMETRY
test --test_env=TT_FABRIC_PROFILE_RX_CH_FWD

# --- Watcher & debug ---
test --test_env=TT_METAL_WATCHER
test --test_env=TT_METAL_WATCHER_APPEND
test --test_env=TT_METAL_WATCHER_NOINLINE
test --test_env=TT_METAL_WATCHER_TEST_MODE
test --test_env=TT_METAL_LIGHTWEIGHT_KERNEL_ASSERTS
test --test_env=TT_METAL_GTEST_NUM_HW_CQS

# --- Profiler ---
test --test_env=TT_METAL_PROFILER_DISABLE_DUMP_TO_FILES

# --- Simulator ---
test --test_env=TT_METAL_SIMULATOR
test --test_env=TT_METAL_SIMULATOR_HOME

# --- Test output ---
test --test_env=GTEST_OUTPUT

# --- TTNN config ---
test --test_env=TTNN_CONFIG_PATH
test --test_env=TTNN_CONFIG_OVERRIDES

# --- Python / build paths ---
test --test_env=LOGURU_LEVEL
test --test_env=LSAN_OPTIONS

# --- Model weight caches (CI runners mount these) ---
test --test_env=HF_HOME
test --test_env=HF_HUB_CACHE
test --test_env=HF_HUB_OFFLINE
test --test_env=TT_CACHE_HOME

# --- Kernel path override ---
test --test_env=TT_METAL_KERNEL_PATH

# ===========================================================================
# Hardware test filtering
#
# By default, exclude all tests that require Tenstorrent hardware. This makes
# `bazel test ...` useful on CPU-only machines (dev laptops, CI build nodes).
# On machines with hardware, use --config=<arch> to include those tests.
#
# Usage:
#   bazel test ...                      # CPU-only (~2 tests)
#   bazel test --config=wormhole_b0 ... # Single Wormhole B0 card
#   bazel test --config=blackhole ...   # Single Blackhole card
#   bazel test --config=n150 ...        # N150 (1-chip WH)
#   bazel test --config=n300 ...        # N300 (2-chip WH)
#   bazel test --config=t3000 ...       # T3000 (8-chip WH)
#   bazel test --config=galaxy ...      # Galaxy (32+ chip WH)
# ===========================================================================

test --test_tag_filters=-requires_wormhole_b0,-requires_blackhole,-requires_multi_device,-requires_galaxy,-requires_T3000,-requires_N150,-requires_N300,-ttsim

# TTSim (CPU-only, simulated hardware)
test:ttsim --test_tag_filters=ttsim,-slow,-frequently_hangs,-monolithic

# Wormhole B0 single-card
test:wormhole_b0 --test_tag_filters=requires_wormhole_b0,-requires_blackhole,-requires_multi_device,-requires_galaxy,-requires_T3000,-requires_N150,-requires_N300,-ttsim
test:wormhole_b0 --strategy=TestRunner=local
test:wormhole_b0 --test_env=ARCH_NAME=wormhole_b0

# Blackhole single-card
test:blackhole --test_tag_filters=requires_blackhole,-requires_multi_device,-requires_galaxy,-requires_T3000,-requires_N150,-requires_N300,-ttsim
test:blackhole --strategy=TestRunner=local
test:blackhole --test_env=ARCH_NAME=blackhole

# N150 (1-chip Wormhole)
test:n150 --test_tag_filters=requires_wormhole_b0,-requires_blackhole,-requires_multi_device,-requires_galaxy,-requires_T3000,-requires_N300,-ttsim
test:n150 --strategy=TestRunner=local
test:n150 --test_env=ARCH_NAME=wormhole_b0

# N300 (2-chip Wormhole)
test:n300 --test_tag_filters=requires_wormhole_b0,-requires_blackhole,-requires_galaxy,-requires_T3000,-requires_N150,-ttsim
test:n300 --strategy=TestRunner=local
test:n300 --test_env=ARCH_NAME=wormhole_b0

# T3000 (8-chip Wormhole)
test:t3000 --test_tag_filters=requires_T3000,-requires_blackhole,-requires_galaxy,-requires_N150,-requires_N300,-ttsim
test:t3000 --strategy=TestRunner=local
test:t3000 --test_env=ARCH_NAME=wormhole_b0

# Galaxy (32+ chip Wormhole)
test:galaxy --test_tag_filters=requires_galaxy,-requires_blackhole,-requires_T3000,-requires_N150,-requires_N300,-ttsim
test:galaxy --strategy=TestRunner=local
test:galaxy --test_env=ARCH_NAME=wormhole_b0
