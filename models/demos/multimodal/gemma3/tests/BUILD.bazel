# Gemma-3 multimodal model tests.
# Referenced by: t3k_unit_tests (gemma3-small), t3k_perf_tests (gemma3 perf).

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "gemma3_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//models/common:utility_functions",
        "//ttnn/ttnn:ttnn_py",
        "@pip//loguru",
        "@pip//torch",
        "@pip//transformers",
    ],
    markers = ["slow"],
    tags = ["ttnn", "nightly", "models", "requires_wormhole_b0"],
)

exports_files(["conftest.py"])
