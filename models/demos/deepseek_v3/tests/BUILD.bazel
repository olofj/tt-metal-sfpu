# DeepSeek v3 model tests.

package(default_visibility = ["//visibility:public"])

exports_files(["conftest.py"])

load("//bazel:pytest.bzl", "pytest_suite")

pytest_suite(
    name = "deepseek_v3_tests",
    srcs = glob(["test_*.py"]),
    deps = [
        "//models/common:utility_functions",
        "//ttnn/ttnn:ttnn_py",
        "@pip//loguru",
        "@pip//torch",
        "@pip//transformers",
        "//tests/ttnn:test_utils",
    ],
    markers = ["slow"],
    tags = ["ttnn", "nightly", "models", "requires_wormhole_b0"],
)
