# TT-Transformers demo tests and utilities.
# simple_text_demo.py is the most heavily referenced test file in the T3000/Galaxy
# pipelines — used by Llama3, Mixtral, Mistral, Qwen2.5, Qwen3, and Galaxy demos.

load("@rules_python//python:py_library.bzl", "py_library")
load("//bazel:pytest.bzl", "pytest_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "trace_region_config",
    testonly = True,
    srcs = ["trace_region_config.py"],
    deps = [
        "//ttnn/ttnn:ttnn_py",
        "//models/common:utility_functions",
        "@pip//loguru",
    ],
)

pytest_test(
    name = "test_simple_text_demo",
    srcs = ["simple_text_demo.py"],
    deps = [
        ":trace_region_config",
        "//models/common:utility_functions",
        "//ttnn/ttnn:ttnn_py",
        "@pip//loguru",
        "@pip//torch",
        "@pip//transformers",
    ],
    markers = ["slow"],
    tags = ["ttnn", "nightly", "models", "requires_wormhole_b0"],
    timeout_seconds = 1800,
)

pytest_test(
    name = "test_simple_vision_demo",
    srcs = ["simple_vision_demo.py"],
    deps = [
        ":trace_region_config",
        "//models/common:utility_functions",
        "//ttnn/ttnn:ttnn_py",
        "@pip//loguru",
        "@pip//torch",
        "@pip//transformers",
    ],
    markers = ["slow"],
    tags = ["ttnn", "nightly", "models", "requires_wormhole_b0"],
    timeout_seconds = 900,
)
