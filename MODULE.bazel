module(
    name = "tt-metalium",
    version = "0.1",
)

# ===========================================================================
# Bazel infrastructure
# ===========================================================================

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_python", version = "1.4.0")

# ===========================================================================
# Dependencies available on the Bazel Central Registry (BCR)
# ===========================================================================

# Boost (modularized on BCR — one module per component)
bazel_dep(name = "boost.algorithm", version = "1.87.0")
bazel_dep(name = "boost.asio", version = "1.87.0")
bazel_dep(name = "boost.container", version = "1.87.0")
bazel_dep(name = "boost.core", version = "1.87.0")
bazel_dep(name = "boost.interprocess", version = "1.87.0")
bazel_dep(name = "boost.smart_ptr", version = "1.87.0")

# Protocol Buffers — v21.12 (same as CMake build).
# We deliberately avoid BCR's protobuf module because transitive deps (via
# google_benchmark → googletest) pull it to v29+ which drags in abseil/zlib.
# Instead, protobuf is fetched via http_archive in extensions.bzl.
# bazel_dep(name = "protobuf", version = "21.7")  # disabled: version conflict

# yaml-cpp 0.8.0
bazel_dep(name = "yaml-cpp", version = "0.8.0")

# Google Test — version 1.15.2 required by google_benchmark@1.9.1.
# CMake build uses 1.13.0 but Bazel Bzlmod MVS resolves to the higher version.
bazel_dep(name = "googletest", version = "1.15.2", repo_name = "com_google_googletest")

# Google Benchmark
bazel_dep(name = "google_benchmark", version = "1.9.1")

# rules_foreign_cc — override transitive dep (from libpfm via google_benchmark)
# Version 0.10.1 uses removed Bazel 9 API (incompatible_use_toolchain_transition).
bazel_dep(name = "rules_foreign_cc", version = "0.14.0")

# fmt — header-only mode used by spdlog
bazel_dep(name = "fmt", version = "11.1.4")

# nlohmann/json
bazel_dep(name = "nlohmann_json", version = "3.11.3")

# range-v3
bazel_dep(name = "range-v3", version = "0.12.0")

# spdlog — configured to use external fmt (header-only)
bazel_dep(name = "spdlog", version = "1.15.2")

# CLI11 — command-line parser, used by tt-train examples
bazel_dep(name = "cli11", version = "2.4.2")

# FlatBuffers — C++ runtime only.
# The BCR entry depends on rules_swift which is incompatible with Bazel 9.
# Fetched via http_archive in extensions.bzl to avoid the conflict.
# bazel_dep(name = "flatbuffers", version = "24.3.25")  # disabled: rules_swift conflict

# ===========================================================================
# Dependencies NOT on BCR — fetched via module extensions
#
# These libraries either have no BCR entry or are TT-specific forks.
# They are managed via http_archive in the non_bcr_deps extension below.
# ===========================================================================

non_bcr_deps = use_extension("//:extensions.bzl", "non_bcr_deps")

# Protocol Buffers v21.12 — pinned outside BCR to avoid abseil dependency.
use_repo(non_bcr_deps, "protobuf")

# Cap'n Proto — has native Bazel support but is not on BCR.
# Pinned to the exact commit used in the CMake build (v1.2.0 + patches).
use_repo(non_bcr_deps, "capnproto")

# nanobind — Python binding library. Not on BCR.
# Pinned to exact commit matching v2.10.2.
use_repo(non_bcr_deps, "nanobind")

# robin-map — hash map library, used by nanobind internals.
# Bundled as nanobind submodule but not included in tarballs.
use_repo(non_bcr_deps, "robin_map")

# xtensor stack — header-only numeric computing libraries. Not on BCR.
use_repo(non_bcr_deps, "xtl")
use_repo(non_bcr_deps, "xtensor")
use_repo(non_bcr_deps, "xtensor_blas")

# simde — SIMD Everywhere, header-only SIMD abstraction. Not on BCR.
use_repo(non_bcr_deps, "simde")

# Taskflow — header-only parallel task programming. Not on BCR.
use_repo(non_bcr_deps, "taskflow")

# boost-ext reflect — single-header reflection library. Not on BCR.
use_repo(non_bcr_deps, "reflect")

# enchantum — TT-used fork of magic_enum. Not on BCR.
use_repo(non_bcr_deps, "enchantum")

# tt-logger — Tenstorrent logging library. Not on BCR.
use_repo(non_bcr_deps, "tt_logger")

# FlatBuffers — C++ runtime. Not on BCR due to rules_swift conflict with Bazel 9.
use_repo(non_bcr_deps, "flatbuffers")

# picosha2 — header-only SHA256 library. Not on BCR. Used by UMD.
use_repo(non_bcr_deps, "picosha2")

# Standalone ASIO — header-only async I/O. Not on BCR. Used by UMD.
use_repo(non_bcr_deps, "asio")

# nng (nanomsg-next-gen) — lightweight messaging. Not on BCR. Used by UMD simulation.
use_repo(non_bcr_deps, "nng")

# libuv — cross-platform async I/O. Not on BCR. Used by UMD simulation.
use_repo(non_bcr_deps, "libuv")

# ===========================================================================
# Hermetic Python 3.12 toolchain (for nanobind extension modules)
#
# Downloads a hermetic CPython 3.12 interpreter from rules_python so the
# build does not depend on system-installed Python headers.  Nanobind
# targets use @rules_python//python/cc:current_py_cc_headers to get the
# Python.h include path from this toolchain.
#
# Python 3.12 is the minimum version for stable ABI (abi3) support,
# matching the Py_LIMITED_API=0x030C0000 define in nanobind.BUILD.
# ===========================================================================

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

python.toolchain(
    python_version = "3.12",
    is_default = True,
)

use_repo(python, "python_3_12")

# ===========================================================================
# Python pip dependencies for tests
#
# Resolves test requirements (pytest, torch, numpy, etc.) from PyPI into
# Bazel-managed repositories. Usage in BUILD files:
#   deps = ["@pip//pytest"]
# ===========================================================================

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//bazel:requirements_test_lock.txt",
)

use_repo(pip, "pip")

# ===========================================================================
# Hermetic Clang 20 host toolchain
#
# Downloads the official LLVM 20 release so the Bazel build does not
# require a system-installed clang-20 package.  Includes clang, LLD,
# libc++ headers/libraries, and LLVM binutils.
# ===========================================================================

clang_ext = use_extension("//:extensions.bzl", "clang_ext")

use_repo(clang_ext, "llvm_clang")

# ===========================================================================
# SFPI RISC-V cross-compilation toolchain
#
# Downloads the pre-built SFPI compiler (riscv-tt-elf-g++) for building
# device firmware targeting Wormhole, Blackhole, and Quasar chips.
# Source of truth: tt_metal/sfpi-version, tt_metal/sfpi-info.sh
# ===========================================================================

sfpi_ext = use_extension("//:extensions.bzl", "sfpi_ext")

use_repo(sfpi_ext, "sfpi")

# ===========================================================================
# C++ toolchains — mirrors cmake/*-toolchain.cmake + cmake/linking.cmake
#
# Hermetic Clang 20 toolchains (downloaded) are registered first so they
# take priority.  System GCC toolchains remain as fallbacks.
# ===========================================================================

register_toolchains(
    "//toolchain/clang:clang20_libcpp",
    "//toolchain/clang:clang20_libstdcpp",
    "//toolchain:gcc12",
    "//toolchain:gcc14",
    "//toolchain/sfpi:sfpi_wormhole",
    "//toolchain/sfpi:sfpi_blackhole",
    "//toolchain/sfpi:sfpi_quasar32",
    "//toolchain/sfpi:sfpi_quasar64",
)
